atedStorage</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000013"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">HardOut</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Animator</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Animator.luau
	Процедурная анимация верхней части тела от первого лица.
	Не требует ни одного ассета: всё считается кодом, поэтому стенд
	запускается сразу после Rojo-синка, без загрузки анимаций.

	Даёт: покачивание рук от шагов, инерцию от поворота камеры,
	наклон в стрейфе, дыхание в покое и в прицеле.
]]

local Animator = {}
Animator.__index = Animator

function Animator.new(camera)
	local self = setmetatable({}, Animator)
	self.camera = camera
	self.time = 0
	self.bobPhase = 0
	self.lookDelta = Vector2.zero
	self.smoothedLook = Vector2.zero
	self.lean = 0
	self.leanTarget = 0
	self.breathPhase = 0
	return self
end

function Animator:AddLookDelta(delta: Vector2)
	self.lookDelta += delta
end

function Animator:SetLeanTarget(value: number)
	self.leanTarget = value
end

--[[
	stepFlags:
		speed       number  — горизонтальная скорость (studs/s)
		isAiming    boolean
		isCrouching boolean
		dt          number

	Возвращает таблицу смещений для модели от первого лица:
		position  Vector3
		rotation  Vector3 (в градусах: pitch, yaw, roll)
]]
function Animator:Step(dt: number, flags)
	self.time += dt
	local speed = flags.speed or 0
	local isAiming = flags.isAiming or false

	-- Частота шага зависит от скорости.
	local frequency = 2.2 * math.sqrt(math.max(speed, 0.001) / 8)
	self.bobPhase += dt * frequency * math.pi * 2

	local moveAmount = math.clamp(speed / 8, 0, 1.6)
	local bobScale = 1
	if isAiming then
		bobScale = 0.35
	end
	local crouchScale = flags.isCrouching and 0.7 or 1

	local bobX = math.cos(self.bobPhase) * 0.35 * moveAmount * bobScale
	local bobY = math.abs(math.sin(self.bobPhase)) * 0.5 * moveAmount * bobScale
	local bobRoll = math.sin(self.bobPhase) * 0.8 * moveAmount * bobScale

	-- Инерция от движения мышью (затухает).
	self.lookDelta = self.lookDelta * math.exp(-dt * 10)
	self.smoothedLook = self.smoothedLook:Lerp(self.lookDelta, math.clamp(dt * 12, 0, 1))
	local lookYaw = math.clamp(self.smoothedLook.X * 0.02, -2.5, 2.5)
	local lookPitch = math.clamp(self.smoothedLook.Y * 0.02, -2.5, 2.5)

	-- Наклон (lean) в стрейфе.
	self.lean += (self.leanTarget - self.lean) * math.clamp(dt * 8, 0, 1)

	-- Дыхание.
	local breathRate = isAiming and 1.4 or 0.8
	self.breathPhase += dt * breathRate * math.pi * 2
	local breath = math.sin(self.breathPhase) * (isAiming and 0.12 or 0.2)

	local position = Vector3.new(bobX * 0.12, bobY * 0.12 + breath * 0.1, 0) * crouchScale

	local rotation = Vector3.new(lookPitch - breath * 0.3, lookYaw, bobRoll + self.lean * 1.2)

	return { position = position, rotation = rotation }
end

--[[ Сброс инерции при телепорте/респавне. ]]
function Animator:Reset()
	self.smoothedLook = Vector2.zero
	self.lookDelta = Vector2.zero
	self.lean = 0
	self.leanTarget = 0
end

return Animator
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">ArmSolver</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	ArmSolver.luau
	Двухкостная IK-математика для рук и ног.
	Чистые функции над Vector3 — без Roblox-специфики, тестируется вне движка.

	Зачем: руки, построенные как "одна палка от плеча до кисти", выглядят деревянно.
	С локтём/коленом модель от первого лица сразу читается как в шутере.
]]

local ArmSolver = {}

--[[
	Решает положение локтя (колена).
		root   — плечо (бедро)
		target — кисть (стопа)
		l1     — длина первого сегмента
		l2     — длина второго сегмента
		hint   — направление, куда выгибать сустав (обычно вниз/в сторону)

	Возвращает позицию сустава и признак "достаёт ли" (false = цель дальше вытянутой руки).
]]
function ArmSolver.solve(root: Vector3, target: Vector3, l1: number, l2: number, hint: Vector3): (Vector3, boolean)
	local toTarget = target - root
	local distance = toTarget.Magnitude

	if distance < 0.0001 then
		return root + hint.Unit * l1, true
	end

	local direction = toTarget / distance
	local reachable = distance <= (l1 + l2) - 0.0001
	local clampedDistance = math.min(distance, l1 + l2 - 0.0001)

	-- Недостижимая цель: рука/нога полностью выпрямляется, сустав строго на оси.
	-- (Иначе на границе радикал даёт микроскопический "излом", который видно как дёрганье.)
	if not reachable then
		local joint = root + direction * (l1 / (l1 + l2)) * (l1 + l2)
		return joint, false
	end

	-- Проекция сустава на ось root->target.
	local a = (l1 * l1 - l2 * l2 + clampedDistance * clampedDistance) / (2 * clampedDistance)
	local hSquared = l1 * l1 - a * a
	local h = hSquared > 0 and math.sqrt(hSquared) or 0

	-- Ортогональная составляющая hint относительно оси.
	local hintPerp = hint - direction * hint:Dot(direction)
	if hintPerp.Magnitude < 0.0001 then
		-- hint параллелен оси: берём любую перпендикулярную ось.
		local fallback = math.abs(direction.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
		hintPerp = fallback - direction * fallback:Dot(direction)
	end
	local side = hintPerp.Unit

	local joint = root + direction * a + side * h
	return joint, reachable
end

--[[
	Возвращает CFrames двух сегментов (плечо->локоть, локоть->кисть),
	чтобы части нужного размера вставали между точками.

	Сегмент — это Part с Size = (толщина, толщина, длина), у которого
	ось Z смотрит от start к finish.
]]
function ArmSolver.segmentCFrame(start: Vector3, finish: Vector3): CFrame
	local delta = finish - start
	local length = delta.Magnitude
	if length < 0.0001 then
		return CFrame.new(start)
	end
	local midpoint = start + delta * 0.5
	return CFrame.lookAt(midpoint, finish)
end

--[[ Длина сегмента между точками. ]]
function ArmSolver.segmentLength(start: Vector3, finish: Vector3): number
	return (finish - start).Magnitude
end

--[[
	Сгибание конечности по фазе шага.
	Возвращает смещение стопы относительно бедра для бегущего цикла.
	phase — фаза в радианах, stride — амплитуда.
]]
function ArmSolver.strideOffset(phase: number, stride: number, lift: number): Vector3
	local z = math.sin(phase) * stride
	local y = -math.max(0, math.cos(phase)) * lift
	return Vector3.new(0, y, z)
end

return ArmSolver
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Config</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Config.luau
	Все настройки тестового стенда в одном месте.
	Начинать правки стоит отсюда — почти всё поведение крутится здесь.
]]

local Config = {}

--[[ Инвентарь ]]
Config.Inventory = {
	-- Сколько слотов рисуется в хотбаре (максимум 9 — по числу клавиш).
	Slots = 9,
	FirstSlot = 1,
}

--[[ Камера / вид от первого лица ]]
Config.Camera = {
	BaseFov = 75,
	FovLerpSpeed = 10,

	-- Наклон камеры при стрейфе (градусы). Мягко: 1.0-1.5, "тарковее": 2.5+.
	LeanAngle = 1.2,

	-- Покачивание головы при ходьбе (мягкое, чтобы не укачивало).
	HeadBob = {
		Enabled = true,
		Amplitude = 0.045, -- studs
		Frequency = 1.5, -- множитель к частоте шага
	},

	-- Сила "тряски" от выстрела. 0 = совсем без тряски.
	ShakeScale = 0.35,

	-- Сглаживание поворота: 0 = 1:1 с мышью, 0.3-0.4 = мягко (не "дёргает").
	Smoothing = 0.3,

	-- Прятать системный курсор и запирать его в центре экрана.
	HideCursor = true,

	-- Рисовать свой прицел в центре. false = чистая картинка без точки.
	ShowCrosshair = false,

	-- Смещение глаз относительно головы персонажа.
	EyeOffset = Vector3.new(0, 0.35, 0),

	-- Насколько камера выдвинута вперёд из головы (studs).
	-- 0 = камера внутри головы (тело почти не видно), 0.5-0.8 = видно торс/живот.
	EyeForward = 0.6,
}

--[[ Руки и ноги от первого лица ]]
Config.ViewModel = {
	-- Как показывать тело:
	--   "Character"   — НАСТОЯЩИЙ персонаж: его руки, ноги и штатные анимации
	--                   (рекомендуется: живые анимации Roblox, видны руки и ноги).
	--   "Procedural"  — процедурные руки/ноги из кода (без ассетов, свои позы).
	Mode = "Character",

	-- Для Mode = "Procedural".
	Enabled = true,
	ShowLegs = true,
	HideCharacterLimbs = true,
	Offset = CFrame.new(0, 0, 0),

	-- Прятать голову и головные аксессуары (шляпы/маски), чтобы не закрывали обзор.
	HideHead = true,

	-- ВИДЕТЬ СВОЁ ТЕЛО от первого лица (руки, ноги, живот/торс).
	-- false -> штатное поведение Roblox: тело локально прозрачное.
	ShowBody = true,
}

--[[ Оружие в руках ]]
Config.Weapons = {
	-- Папка в ReplicatedStorage с моделями оружия (Model).
	FolderPath = "ReplicatedStorage.WeaponModels",

	-- Подгонять размер модели под эталон.
	AutoScale = false,

	-- Звук выстрела: свой rbxassetid, пусто = без звука.
	ShotSoundId = "",

	-- Куда крепится оружие ОТНОСИТЕЛЬНО кисти (RightHand / Right Arm).
	-- Если пушка смотрит вверх/вбок — крути именно это, а не модель:
	--   CFrame.Angles(math.rad(-90), 0, 0) разворачивает ствол вдоль руки.
	HandGripCFrame = CFrame.new(0, -0.35, 0) * CFrame.Angles(math.rad(-90), 0, 0),

	-- Имя части-кисти для разных ригов (R15 / R6).
	HandNames = { "RightHand", "Right Arm" },

	-- Сдвиг модели оружия в прицеле (ADS): придвигаем к центру экрана.
	AimOffset = CFrame.new(0, 0.12, -0.15),
}

--[[ Движение — намеренно медленнее роблоксового, в духе Таркова ]]
Config.Movement = {
	WalkSpeed = 8,
	AimWalkSpeed = 4.5,
	SprintSpeed = 15,
	CrouchSpeed = 3.5,
	JumpPower = 42,
	-- Время разгона/торможения (сек).
	AccelerationTime = 0.16,
}

--[[ Тестовый полигон ]]
Config.TestRange = {
	-- false -> полигон не строится (если хочешь свой уровень).
	Enabled = true,
}

--[[ Отладка ]]
Config.Debug = {
	-- Печатать в консоль, что найдено/создано (модели, сокеты, полигон).
	Verbose = true,
	-- Время жизни трассера (сек).
	TraceLifetime = 0.12,
}

--[[ Клавиши (используются в client/modules/Input.luau) ]]
Config.Keys = {
	Sprint = Enum.KeyCode.LeftShift,
	Crouch = Enum.KeyCode.C,
	Reload = Enum.KeyCode.R,
	Unequip = Enum.KeyCode.X,
}

return Config
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Signal</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Signal.luau
	Минимальный сигнал (без RBXScriptSignal), чтобы модули не зависели от Instances.
	Нужен для событий вида "персонаж загрузился" / "риг пересоздан".
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if self._disconnected then
		return
	end
	self._disconnected = true
	self._signal._connections[self] = nil
end

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(callback)
	local connection = setmetatable({
		_signal = self,
		_callback = callback,
		_disconnected = false,
	}, Connection)
	self._connections[connection] = true
	return connection
end

function Signal:Fire(...)
	-- Копия, чтобы отписки внутри колбэка не ломали обход.
	local snapshot = {}
	for connection in pairs(self._connections) do
		table.insert(snapshot, connection)
	end
	for _, connection in snapshot do
		if not connection._disconnected then
			task.spawn(connection._callback, ...)
		end
	end
end

function Signal:DisconnectAll()
	for connection in pairs(self._connections) do
		connection._disconnected = true
	end
	table.clear(self._connections)
end

return Signal
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Folder" referent="RBX0000000000000000000000000000000A"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">Net</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Remotes</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Remotes.luau
	Имена и ленивое создание RemoteEvent'ов. Сервер создаёт их в ReplicatedStorage.HardOut.Net,
	клиент только ждёт. Один список — чтобы не расползлись опечатки.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

Remotes.Names = {
	Fire = "Fire", -- client -> server: запрос выстрела
	ShotResult = "ShotResult", -- server -> client: подтверждённый выстрел (трассер/попадание)
	Reload = "Reload", -- client -> server: перезарядка
	Inventory = "Inventory", -- server -> client: список выданного оружия и патронов
	StateUpdate = "StateUpdate", -- server -> client: патроны/перезарядка
}

function Remotes.getFolder(): Instance
	local hardOut = ReplicatedStorage:FindFirstChild("HardOut")
	local folder = hardOut and hardOut:FindFirstChild("Net")
	if not folder then
		local created = Instance.new("Folder")
		created.Name = "Net"
		created.Parent = hardOut
		return created
	end
	return folder
end

function Remotes.get(name: string): RemoteEvent
	local folder = Remotes.getFolder()
	local remote = folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	if not remote then
		local created = Instance.new("RemoteEvent")
		created.Name = name
		created.Parent = folder
		return created
	end
	error(`Remotes: "{name}" существует, но это не RemoteEvent`)
end

function Remotes.waitFor(name: string): RemoteEvent
	local folder = ReplicatedStorage:WaitForChild("HardOut"):WaitForChild("Net")
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000012"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">Weapon</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">AimSolver</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	AimSolver.luau
	Мозг стрельбы: решает, куда попала пуля и сколько урона нанести.
	Специально отделён от Roblox-специфики: физика попадания приходит
	через resolver (origin, direction, range) -> результат raycast или nil.

	Чистую часть можно гонять в юнит-тестах без движка.
]]

local Ballistics = require(script.Parent.Ballistics)

local AimSolver = {}

local HEAD_PARTS = {
	Head = true,
	head = true,
}

local LIMB_PARTS = {
	LeftArm = true,
	RightArm = true,
	LeftLeg = true,
	RightLeg = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
}

--[[ Имя части -> множитель урона. ]]
function AimSolver.zoneMultiplier(partName, stats)
	if HEAD_PARTS[partName] then
		return stats.HeadshotMult
	end
	if LIMB_PARTS[partName] then
		return 0.7
	end
	if partName == "HumanoidRootPart" then
		return 1.0
	end
	return 1.0
end

--[[
	Основной расчёт выстрела.
	origin/direction — из камеры, spreadDegrees — уже посчитанный разброс,
	rng — функция 0..1 (детерминированная в тестах).
]]
function AimSolver.solve(params)
	local stats = params.stats
	local direction = Ballistics.applySpread(params.direction, params.spreadDegrees, params.rng)
	local result = params.resolver(params.origin, direction, stats.Range)

	if not result then
		return {
			Hit = false,
			Position = params.origin + direction * stats.Range,
			Normal = Vector3.new(0, 1, 0),
			Distance = stats.Range,
			Direction = direction,
			PartName = "",
			Damage = 0,
			IsHead = false,
		}
	end

	local part = result.Instance
	local partName = part and part.Name or tostring(result.PartName or "")
	local isHead = HEAD_PARTS[partName] == true
	local damage = stats.Damage * AimSolver.zoneMultiplier(partName, stats)

	return {
		Hit = true,
		Position = result.Position,
		Normal = result.Normal or Vector3.new(0, 1, 0),
		Distance = (result.Position - params.origin).Magnitude,
		Direction = direction,
		PartName = partName,
		Instance = part,
		Damage = damage,
		IsHead = isHead,
		Material = result.Material,
	}
end

--[[ Разброс: стойка / прицел / движение. ]]
function AimSolver.computeSpread(stats, isAiming, speedRatio)
	local spread = isAiming and stats.SpreadAim or stats.Spread
	local ratio = math.clamp(speedRatio or 0, 0, 2)
	spread *= 1 + ratio * 0.8
	if isAiming then
		spread *= 0.6
	end
	return spread
end

return AimSolver
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Ballistics</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Ballistics.luau
	Чистая математика стрельбы: разброс, паттерн отдачи, падение пули.
	Модуль намеренно не трогает Roblox API (кроме Vector3/CFrame),
	поэтому его можно прогонять юнит-тестами вне движка (см. tests/).
]]

local Ballistics = {}

--[[ Случайный единичный вектор внутри конуса с полууглом coneDegrees. ]]
function Ballistics.applySpread(direction, coneDegrees, rng)
	if coneDegrees <= 0 then
		return direction.Unit
	end

	local dir = direction.Unit
	local cosLimit = math.cos(math.rad(math.clamp(coneDegrees, 0, 89)))

	-- Ортонормированный базис вокруг направления.
	local reference = math.abs(dir.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local right = dir:Cross(reference).Unit
	local trueUp = right:Cross(dir).Unit

	-- Равномерно по площади конуса (sqrt по косинусу).
	local u1 = rng()
	local u2 = rng()
	local cosTheta = 1 - u1 * (1 - cosLimit)
	local sinTheta = math.sqrt(math.max(0, 1 - cosTheta * cosTheta))
	local phi = u2 * math.pi * 2

	local result = dir * cosTheta + right * (math.cos(phi) * sinTheta) + trueUp * (math.sin(phi) * sinTheta)
	return result.Unit
end

--[[
	Паттерн отдачи: возвращает {yaw, pitch} в градусах для выстрела shotIndex (0-based).
	Первые выстрелы почти в точку, дальше уводит вверх-вправо, потом рандом,
	чтобы паттерн нельзя было выучить наизусть.
]]
function Ballistics.recoilOffset(stats, shotIndex, rng)
	local scale = stats.Recoil or 1
	local climb = math.min(shotIndex, 12) * 0.55
	local drift = math.min(shotIndex, 12) * 0.18
	local jitterX = (rng() - 0.5) * 0.5 * math.min(shotIndex, 8)
	local jitterY = (rng() - 0.5) * 0.5

	local pitch = (climb + jitterY) * scale
	local yaw = (drift + jitterX) * scale
	return yaw, pitch
end

--[[
	Интегрирует падение пули: возвращает новое направление через dt секунд
	и пройденную этим шагом дистанцию.
]]
function Ballistics.integrate(direction, speed, dt, gravity)
	local g = gravity or 196.2
	local velocity = direction.Unit * speed
	local delta = velocity * dt + Vector3.new(0, -0.5 * g * dt * dt, 0)
	return delta.Unit, delta.Magnitude
end

--[[ Время полёта пули на дистанцию (для задержки урона на больших расстояниях). ]]
function Ballistics.travelTime(distance, speed)
	return distance / math.max(speed, 1)
end

--[[ На какой угол (в градусах) задрать ствол, чтобы попасть в точку на distance. ]]
function Ballistics.dropCompensation(distance, speed, gravity)
	local g = gravity or 196.2
	if speed <= 0 or distance <= 0 then
		return 0
	end
	local t = distance / speed
	local drop = 0.5 * g * t * t
	return math.deg(math.atan(drop / distance))
end

--[[ Куда целиться, чтобы пуля прилетела в target (поправка на падение). ]]
function Ballistics.aimAdjust(origin, target, speed, gravity)
	local flat = Vector3.new(target.X, 0, target.Z) - Vector3.new(origin.X, 0, origin.Z)
	local horizontalDistance = flat.Magnitude
	if horizontalDistance < 0.01 then
		return target
	end
	local correction = Ballistics.dropCompensation(horizontalDistance, speed, gravity)
	local axis = Vector3.new(flat.X, 0, flat.Z).Unit:Cross(Vector3.new(0, 1, 0))
	-- Вращаем "вверх" относительно горизонтали: поднимаем точку прицеливания.
	local offset = (target - origin)
	local rotated = CFrame.fromAxisAngle(axis, math.rad(-correction)) * offset
	return origin + rotated
end

return Ballistics
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">GunPreset</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	GunPreset.luau
	Как выглядит "правильная" модель оружия для этого стенда + хелперы,
	чтобы быстро проверить твою модель и починить её, если что-то не так.

	СОГЛАШЕНИЕ ПО МОДЕЛИ (все пункты опциональны, кроме Attachments):
	  Model / Tool
	    └─ Attachments (Model или Folder)      -- обязательная папка с точками крепления
	         ├─ Grip        (Attachment)       -- куда приходит правая рука
	         ├─ Support     (Attachment)       -- куда приходит левая рука (опционально)
	         ├─ Muzzle      (Attachment)       -- срез ствола (опционально, но нужен для выстрела)
	         └─ Sight       (Attachment)       -- центр прицела для ADS (опционально)
	    └─ ... любые MeshPart'ы твоей модели ...

	Конвенция осей (важно!):
	  - Модель привязывается к руке через Grip.
	  - Смотрит стволом в -Z (вперёд), "вверх" оружия = +Y.
	  - Т.е. если голова оружия смотрит не туда — меняй CFrame самого Grip,
	    а не крути всю модель.
]]

local GunPreset = {}

GunPreset.AttachmentNames = {
	Grip = "Grip",
	Support = "Support",
	Muzzle = "Muzzle",
	Sight = "Sight",
}

-- Стандартные размеры модели оружия для авто-масштабирования.
GunPreset.ReferenceSize = Vector3.new(0.9, 1.9, 3.2) -- X,Y,Z; Z = длина ствола

function GunPreset.findAttachmentsFolder(model: Instance): Instance?
	for _, descendant in model:GetDescendants() do
		if descendant.Name == "Attachments" and (descendant:IsA("Model") or descendant:IsA("Folder")) then
			return descendant
		end
	end
	return nil
end

function GunPreset.getAttachment(model: Instance, name: string): Attachment?
	local folder = GunPreset.findAttachmentsFolder(model)
	local candidates: Instance? = folder
	if not candidates then
		candidates = model
	end
	local found = (candidates :: Instance):FindFirstChild(name, true)
	if found and found:IsA("Attachment") then
		return found
	end
	return nil
end

--[[
	Диагностика модели. Возвращает список проблем (строк) и таблицу с найденным.
	Используется стендом при загрузке и печатается в консоль.
]]
function GunPreset.diagnose(model: Instance): (string?, { [string]: Attachment })
	local issues: { string } = {}
	local found: { [string]: Attachment } = {}

	if not model:IsA("Model") then
		table.insert(issues, "это не Model: стенд ждёт Model (Tool не поддерживается)")
	end

	for key, attachmentName in GunPreset.AttachmentNames do
		local attachment = GunPreset.getAttachment(model, attachmentName)
		if attachment then
			found[key] = attachment
		elseif key == "Grip" then
			table.insert(
				issues,
				`нет обязательной точки "{attachmentName}" (рука не найдёт оружие)`
			)
		end
	end

	local folder = GunPreset.findAttachmentsFolder(model)
	if not folder then
		table.insert(
			issues,
			"нет папки Attachments — оружие всё равно загрузится, но без сокетов"
		)
	end

	local hasPrimary = false
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			hasPrimary = true
			break
		end
	end
	if not hasPrimary then
		table.insert(issues, "в модели нет ни одной BasePart")
	end

	if #issues == 0 then
		return nil, found
	end
	return table.concat(issues, "; "), found
end

function GunPreset.computeSize(model: Instance): Vector3
	local ok, size = pcall(function()
		return model:GetExtentsSize()
	end)
	if ok then
		return size
	end
	return Vector3.zero
end

--[[
	Возвращает масштаб, который нужно применить к модели, чтобы попасть в ReferenceSize.
	0.5..2.5 ограничение, чтобы модель не улетела в бесконечность.
]]
function GunPreset.computeScale(model: Instance): number
	local size = GunPreset.computeSize(model)
	if size.Magnitude <= 0 then
		return 1
	end
	local longest = math.max(size.X, size.Y, size.Z)
	local reference = math.max(GunPreset.ReferenceSize.X, GunPreset.ReferenceSize.Y, GunPreset.ReferenceSize.Z)
	local scale = reference / longest
	return math.clamp(scale, 0.5, 2.5)
end

--[[
	Безопасно масштабирует модель.
	Использует штатный Model:ScaleTo, который корректно масштабирует и части,
	и сварки, и Attachment'ы. Если API недоступен — откат на ручной вариант.
]]
function GunPreset.applyScale(model: Instance, scale: number)
	if math.abs(scale - 1) < 0.01 then
		return
	end

	if not model:IsA("Model") then
		warn(
			`[HardOut] Автомасштаб поддерживается только для Model (не "${model.ClassName}").`
		)
		return
	end

	local succeeded = pcall(function()
		model:ScaleTo(scale)
	end)
	if succeeded then
		return
	end

	-- Откат: масштабируем части относительно пивота и Attachment'ы.
	warn("[HardOut] Model:ScaleTo недоступен, масштабирую вручную.")
	local pivot = model:GetPivot()
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local part = descendant :: BasePart
			part.Size = part.Size * scale
			local offset = pivot:ToObjectSpace(part.CFrame)
			part.CFrame = pivot * CFrame.new(offset.Position * scale) * offset.Rotation
		elseif descendant:IsA("Attachment") then
			local attachment = descendant :: Attachment
			attachment.Position = attachment.Position * scale
		end
	end
end

return GunPreset
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000E"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Recoil</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Recoil.luau
	Отдача как состояние во времени, а не как разовый нокбек.
	Используется камерой каждый кадр: camera:Step(dt), camera:AddShot(stats, shotIndex).

	Модель intentionally простая:
	  - kick: импульс вверх (затухает пружиной),
	  - recoilOffset: накопленное смещение прицела (возвращается к нулю само),
	  - sway: инерция от вращения мышью (задел под "тяжёлое" ощущение Таркова).
]]

local Recoil = {}
Recoil.__index = Recoil

function Recoil.new()
	local self = setmetatable({}, Recoil)
	self.kickPitch = 0
	self.kickYaw = 0
	self.offsetPitch = 0
	self.offsetYaw = 0
	self.swayYaw = 0
	self.swayPitch = 0
	self.time = 0
	self.enabled = true
	return self
end

--[[ Импульс от одного выстрела. yaw/pitch в градусах (обычно из Ballistics.recoilOffset). ]]
function Recoil:AddShot(yawDegrees, pitchDegrees, visualMult)
	local visual = visualMult or 1
	self.kickPitch += pitchDegrees * 0.05 * visual
	self.kickYaw += yawDegrees * 0.05 * visual
	self.offsetPitch += pitchDegrees * visual
	self.offsetYaw += yawDegrees * visual
end

--[[ Инерция от движения мышью (вызывать при InputChanged). ]]
function Recoil:AddLook(deltaX, deltaY)
	local influence = 0.01
	self.swayYaw = math.clamp(self.swayYaw - deltaX * influence, -4, 4)
	self.swayPitch = math.clamp(self.swayPitch - deltaY * influence, -4, 4)
end

--[[ Кадровое обновление. Возвращает смещение камеры (yaw, pitch) в градусах. ]]
function Recoil:Step(dt, recoveryRate)
	if not self.enabled then
		return 0, 0
	end
	self.time += dt
	local rate = recoveryRate or 9

	-- Пружина для kick (визуальная тряска).
	local damping = math.exp(-dt * 14)
	self.kickPitch *= damping
	self.kickYaw *= damping

	-- Возврат накопленного увода прицела (медленнее, чем тряска).
	local offsetDamping = math.exp(-dt * (rate * 0.35))
	self.offsetPitch *= offsetDamping
	self.offsetYaw *= offsetDamping

	-- Sway возвращается к нулю.
	local swayDamping = math.exp(-dt * 6)
	self.swayYaw *= swayDamping
	self.swayPitch *= swayDamping

	return self.offsetYaw + self.swayYaw + self.kickYaw, self.offsetPitch + self.swayPitch + self.kickPitch
end

--[[ Сброс (например, при смене оружия). ]]
function Recoil:Reset()
	self.kickPitch = 0
	self.kickYaw = 0
	self.offsetPitch = 0
	self.offsetYaw = 0
	self.swayYaw = 0
	self.swayPitch = 0
end

return Recoil
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000F"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Spring</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	Spring.luau
	Маленькая пружина (критически задемпфированная) для сглаживания:
	прицеливания, FOV, покачивания рук, смещений. Без Roblox API.
]]

local Spring = {}
Spring.__index = Spring

function Spring.new(initial: number, stiffness: number?, damping: number?)
	local self = setmetatable({}, Spring)
	self.value = initial or 0
	self.target = initial or 0
	self.velocity = 0
	self.stiffness = stiffness or 180
	self.damping = damping or 14
	return self
end

function Spring:SetTarget(target: number)
	self.target = target
end

--[[ Возвращает текущее значение. ]]
function Spring:Step(dt: number): number
	dt = math.min(dt, 1 / 15) -- защита от лагов
	local delta = self.target - self.value
	self.velocity += delta * self.stiffness * dt
	self.velocity *= math.exp(-self.damping * dt)
	self.value += self.velocity * dt
	return self.value
end

function Spring:Snap(value: number)
	self.value = value
	self.target = value
	self.velocity = 0
end

return Spring
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">WeaponConfig</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	WeaponConfig.luau
	Статы оружия. Читаются из атрибутов на модели оружия, а если атрибутов нет —
	берётся пресет по названию модели (PM / AK / M4 ...) или общий дефолт.

	Атрибуты на модели (все опциональны, числа/булевы):
		RoundsPerMinute  number  -> темп стрельбы
		Damage           number  -> урон
		HeadshotMult     number  -> множитель за голову
		MagazineSize     number  -> ёмкость магазина
		ReloadTime       number  -> секунды перезарядки
		Spread           number  -> разброс в градусах (стойка)
		Recoil           number  -> сила отдачи (градусы)
		Auto             bool    -> автоматический огонь
		AmmoType         string  -> название патронов для UI
		AdsFov           number  -> FOV в прицеле
		Penetration      number  -> 0..1, запас "пробития" (задел под броню)

	Так же можно просто поменять пресеты ниже.
]]

local WeaponConfig = {}

export type Stats = {
	RoundsPerMinute: number,
	Damage: number,
	HeadshotMult: number,
	MagazineSize: number,
	ReloadTime: number,
	Spread: number,
	SpreadAim: number,
	Recoil: number,
	RecoilVisual: number,
	Auto: boolean,
	AmmoType: string,
	AdsFov: number,
	Penetration: number,
	Range: number,
}

WeaponConfig.Defaults = {
	RoundsPerMinute = 600,
	Damage = 34,
	HeadshotMult = 2.2,
	MagazineSize = 17,
	ReloadTime = 2.2,
	Spread = 1.6,
	SpreadAim = 0.25,
	Recoil = 0.55,
	RecoilVisual = 1,
	Auto = false,
	AmmoType = "9x18",
	AdsFov = 55,
	Penetration = 0.2,
	Range = 350,
} :: Stats

-- Пресеты по подстроке в имени модели (регистр не важен).
WeaponConfig.Presets = {
	{
		match = { "pm", "пистолет", "makarov", "p226" },
		stats = {
			RoundsPerMinute = 320,
			Damage = 32,
			MagazineSize = 17,
			ReloadTime = 2.0,
			Spread = 2.4,
			SpreadAim = 0.4,
			Recoil = 0.8,
			Auto = false,
			AmmoType = "9x18",
			AdsFov = 60,
			Range = 150,
		},
	},
	{
		match = { "ak", "ak74", "akm", "ака" },
		stats = {
			RoundsPerMinute = 650,
			Damage = 42,
			MagazineSize = 30,
			ReloadTime = 2.6,
			Spread = 1.8,
			SpreadAim = 0.18,
			Recoil = 1.15,
			Auto = true,
			AmmoType = "5.45x39",
			AdsFov = 45,
			Range = 400,
		},
	},
	{
		match = { "m4", "ar15", "ar-15", "hk416" },
		stats = {
			RoundsPerMinute = 800,
			Damage = 34,
			MagazineSize = 30,
			ReloadTime = 2.4,
			Spread = 1.2,
			SpreadAim = 0.12,
			Recoil = 0.85,
			Auto = true,
			AmmoType = "5.56x45",
			AdsFov = 45,
			Range = 420,
		},
	},
	{
		match = { "mp5", "smg", "пп" },
		stats = {
			RoundsPerMinute = 900,
			Damage = 24,
			MagazineSize = 30,
			ReloadTime = 2.2,
			Spread = 2.0,
			SpreadAim = 0.3,
			Recoil = 0.7,
			Auto = true,
			AmmoType = "9x19",
			AdsFov = 55,
			Range = 200,
		},
	},
	{
		match = { "mosin", "sv98", "sniper", "свд", "svd" },
		stats = {
			RoundsPerMinute = 45,
			Damage = 120,
			MagazineSize = 10,
			ReloadTime = 3.4,
			Spread = 1.0,
			SpreadAim = 0.02,
			Recoil = 3.2,
			Auto = false,
			AmmoType = "7.62x54",
			AdsFov = 18,
			Range = 700,
		},
	},
}

local function copyStats(source: { [string]: any }): Stats
	local stats: any = {}
	for key, value in WeaponConfig.Defaults :: any do
		stats[key] = value
	end
	for key, value in source do
		stats[key] = value
	end
	return stats :: Stats
end

function WeaponConfig.fromName(name: string): Stats
	local lower = string.lower(name)
	for _, preset in WeaponConfig.Presets do
		for _, key in preset.match do
			if string.find(lower, key, 1, true) then
				return copyStats(preset.stats)
			end
		end
	end
	return copyStats({})
end

--[[ Читает атрибуты с модели и накладывает их поверх пресета. ]]
function WeaponConfig.fromModel(model: Instance): Stats
	local stats: any = WeaponConfig.fromName(model.Name)
	local attributeNames = {
		"RoundsPerMinute",
		"Damage",
		"HeadshotMult",
		"MagazineSize",
		"ReloadTime",
		"Spread",
		"SpreadAim",
		"Recoil",
		"RecoilVisual",
		"Auto",
		"AmmoType",
		"AdsFov",
		"Penetration",
		"Range",
	}
	for _, key in attributeNames do
		local value = model:GetAttribute(key)
		if value ~= nil then
			stats[key] = value
		end
	end
	return stats :: Stats
end

--[[ Сколько времени между выстрелами в секундах. ]]
function WeaponConfig.secondsPerShot(stats: Stats): number
	return 60 / math.max(stats.RoundsPerMinute, 1)
end

return WeaponConfig
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000011"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">WeaponState</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!strict
--[[
	WeaponState.luau
	Состояние одного оружия: патроны, магазин, перезарядка, режим огня.
	Чистая логика без Roblox API -> тестируется в юнит-тестах.

	Один экземпляр на слот инвентаря. Клиент и сервер держат свои экземпляры;
	сервер — источник истины, клиент предсказывает для отзывчивости.
]]

local WeaponState = {}
WeaponState.__index = WeaponState

export type Mode = "Semi" | "Auto" | "Burst"

function WeaponState.new(stats, ammoInMagazine: number?)
	local self = setmetatable({}, WeaponState)
	self.stats = stats
	self.magazine = ammoInMagazine or stats.MagazineSize
	self.reserve = stats.ReserveAmmo or stats.MagazineSize * 4
	self.reloading = false
	self.reloadEndsAt = 0
	self.lastShotAt = -math.huge
	self.shotIndex = 0
	self.triggerHeld = false
	self.boltReady = true
	return self
end

function WeaponState:isEmpty(): boolean
	return self.magazine <= 0
end

function WeaponState:isFull(): boolean
	return self.magazine >= self.stats.MagazineSize
end

function WeaponState:canFire(now: number): (boolean, string?)
	if self.reloading then
		return false, "Reloading"
	end
	if self.magazine <= 0 then
		return false, "Empty"
	end
	local interval = 60 / math.max(self.stats.RoundsPerMinute, 1)
	if now - self.lastShotAt < interval then
		return false, "FireRate"
	end
	-- Полуавтомат: нужен отпущенный и снова нажатый курок.
	if not self.stats.Auto and self.triggerHeld then
		return false, "SemiAuto"
	end
	return true, nil
end

function WeaponState:fire(now: number)
	self.magazine -= 1
	self.lastShotAt = now
	self.triggerHeld = true
	self.shotIndex += 1
end

function WeaponState:releaseTrigger()
	self.triggerHeld = false
	-- Сброс паттерна отдачи после паузы (решается снаружи по времени).
end

function WeaponState:resetShotPattern()
	self.shotIndex = 0
end

function WeaponState:startReload(now: number): boolean
	if self.reloading or self:isFull() or self.reserve <= 0 then
		return false
	end
	self.reloading = true
	self.reloadEndsAt = now + self.stats.ReloadTime
	return true
end

--[[ Вызывается каждый кадр. Возвращает true, если перезарядка только что завершилась. ]]
function WeaponState:update(now: number): boolean
	if self.reloading and now >= self.reloadEndsAt then
		local needed = self.stats.MagazineSize - self.magazine
		local taken = math.min(needed, self.reserve)
		self.magazine += taken
		self.reserve -= taken
		self.reloading = false
		self.reloadEndsAt = 0
		return true
	end
	return false
end

function WeaponState:reloadProgress(now: number): number
	if not self.reloading then
		return 1
	end
	local total = self.stats.ReloadTime
	if total <= 0 then
		return 1
	end
	return math.clamp(1 - (self.reloadEndsAt - now) / total, 0, 1)
end

return WeaponState
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000014"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">WeaponModels</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX0000000000000000000000000000001C"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000016"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">ServerBoot</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	HardOut — серверная точка входа.
	Поднимает сеть, полигон и (опционально) модели оружия для теста.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local HardOut = ReplicatedStorage:WaitForChild("HardOut", 10)
if not HardOut then
	warn("[HardOut] Не найдена ReplicatedStorage.HardOut — проверь Rojo-синк.")
	return
end
local Config = require(HardOut:WaitForChild("Config"))
local Net = require(HardOut:WaitForChild("Net"):WaitForChild("Remotes"))

-- Папка Modules лежит РЯДОМ со скриптом (сиблинг), а не внутри него.
-- Важно: не block-им поток навсегда — иначе полигон не построится и будет "пусто".
local Modules = script.Parent and script.Parent:FindFirstChild("Modules")
if not Modules then
	warn(
		"[HardOut] НЕ НАЙДЕНА папка Modules рядом с ServerBoot. "
			.. "Скрипт должен лежать в ServerScriptService вместе с папкой Modules."
	)
	return
end

local CombatService = require(Modules:WaitForChild("CombatService"))
local TestRange = require(Modules:WaitForChild("TestRange"))
local RaidSandbox = require(Modules:WaitForChild("RaidSandbox"))
local SampleWeapon = require(Modules:WaitForChild("SampleWeapon"))

-- Все RemoteEvent'ы должны существовать до первого выстрела клиента.
for _, name in Net.Names do
	Net.get(name)
end

-- Папка под модели оружия: создаём, чтобы было куда класть.
local weaponFolder = ReplicatedStorage:FindFirstChild("WeaponModels")
if not weaponFolder then
	weaponFolder = Instance.new("Folder")
	weaponFolder.Name = "WeaponModels"
	weaponFolder.Parent = ReplicatedStorage
end

-- Демо-оружие, чтобы стенд можно было пощупать до появления своей модели.
local sample = SampleWeapon.install(weaponFolder)
if sample and Config.Debug.Verbose then
	print(
		"[HardOut] Папка WeaponModels была пуста — подложил демо-оружие '"
			.. sample.Name
			.. "'."
	)
	print(
		"[HardOut] Когда положишь свою модель, демо можно удалить из папки."
	)
end

-- Полигон.
if Config.Debug.Verbose then
	print("[HardOut] Строю тестовый полигон...")
end
TestRange.build()

CombatService.initialize()
RaidSandbox.initialize()

if Config.Debug.Verbose then
	print("[HardOut] Сервер готов. Оружие кладётся в ReplicatedStorage.WeaponModels.")
end
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Folder" referent="RBX0000000000000000000000000000001B"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">Modules</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000017"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">CombatService</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	CombatService.luau
	Серверная сторона стрельбы: единственное место, где считается урон.

	Клиент присылает только намерение (куда смотрел, из чего стрелял).
	Сервер сам:
	  - находит модель оружия и берёт её статы,
	  - проверяет темп и "нельзя стрелять чаще, чем оружие позволяет",
	  - проверяет, что origin рядом с головой игрока (античит на телепорт пули),
	  - считает raycast и урон (AimSolver: голова/конечности/броня),
	  - рассылает результат всем (трассеры видны всем игрокам).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local WeaponFolder = HardOut:WaitForChild("Weapon")
local Net = require(HardOut:WaitForChild("Net"):WaitForChild("Remotes"))
local AimSolver = require(WeaponFolder:WaitForChild("AimSolver"))
local WeaponConfig = require(WeaponFolder:WaitForChild("WeaponConfig"))

local CombatService = {}

local ORIGIN_TOLERANCE = 14 -- studs от головы
local FIRE_RATE_GRACE = 0.9 -- 10% запас на джиттер сети
local MAX_SHOTS_PER_SECOND = 25

type PlayerState = {
	lastShotAt: number,
	shotCount: number,
	minuteStartedAt: number,
}

local states: { [Player]: PlayerState } = {}

local function getState(player)
	local state = states[player]
	if not state then
		state = { lastShotAt = -math.huge, shotCount = 0, minuteStartedAt = os.clock() }
		states[player] = state
	end
	return state
end

--[[ Находит модель оружия по имени в ReplicatedStorage.WeaponModels. ]]
local function findWeaponModel(name)
	if type(name) ~= "string" then
		return nil
	end
	local folder = ReplicatedStorage:FindFirstChild("WeaponModels")
	if not folder then
		return nil
	end
	local model = folder:FindFirstChild(name, true)
	if model and (model:IsA("Model") or model:IsA("Tool")) then
		return model
	end
	return nil
end

function CombatService.handleFire(player, payload)
	if type(payload) ~= "table" then
		return
	end
	if typeof(payload.origin) ~= "Vector3" or typeof(payload.direction) ~= "Vector3" then
		return
	end

	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (head and humanoid and humanoid.Health > 0) then
		return
	end

	-- Статы оружия: ищем модель, если её нет — берём дефолт (стенд не падает).
	local model = findWeaponModel(payload.weaponName)
	local stats = model and WeaponConfig.fromModel(model) or WeaponConfig.fromName(tostring(payload.weaponName or ""))

	-- 1. Темп стрельбы.
	local state = getState(player)
	local now = os.clock()
	local interval = (60 / math.max(stats.RoundsPerMinute, 1)) * FIRE_RATE_GRACE
	if now - state.lastShotAt < interval then
		return
	end
	state.lastShotAt = now

	-- 2. Грубый лимит выстрелов в минуту (защита от "спидрана").
	if now - state.minuteStartedAt > 1 then
		state.minuteStartedAt = now
		state.shotCount = 0
	end
	state.shotCount += 1
	if state.shotCount > MAX_SHOTS_PER_SECOND then
		return
	end

	-- 3. Origin должен быть у головы (нельзя стрелять из-за стены с другого конца карты).
	if (payload.origin - head.Position).Magnitude > ORIGIN_TOLERANCE then
		return
	end

	-- 4. Направление нормируем сами (клиент не может "продлить" пулю).
	local direction = payload.direction
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit

	-- 5. Разброс считаем на сервере: клиентский шум не даёт преимущества.
	local speedRatio = math.clamp((tonumber(payload.speed) or 0) / 8, 0, 2)
	local spread = AimSolver.computeSpread(stats, payload.aiming == true, speedRatio)

	local rng = Random.new()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, workspace.Camera }
	params.IgnoreWater = true

	local origin = head.Position
		+ (payload.origin - head.Position).Unit * math.min((payload.origin - head.Position).Magnitude, 2)

	local result = AimSolver.solve({
		origin = origin,
		direction = direction,
		stats = stats,
		spreadDegrees = spread,
		rng = function()
			return rng:NextNumber()
		end,
		resolver = function(rayOrigin, rayDirection, range)
			return workspace:Raycast(rayOrigin, rayDirection * range, params)
		end,
	})

	-- 6. Урон только через Humanoid.
	if result.Hit and result.Instance then
		local victimModel = result.Instance:FindFirstAncestorOfClass("Model")
		local victimHumanoid = victimModel and victimModel:FindFirstChildOfClass("Humanoid")
		if victimHumanoid and victimHumanoid.Health > 0 then
			victimHumanoid:TakeDamage(result.Damage)
		end
	end

	-- 7. Всем — трассер и точка попадания.
	CombatService.shotResult:FireAllClients({
		origin = origin,
		position = result.Position,
		normal = result.Normal,
		hit = result.Hit,
		partName = result.PartName,
		damage = result.Damage,
		shooter = player,
	})
end

function CombatService.initialize()
	CombatService.shotResult = Net.get(Net.Names.ShotResult)

	Net.get(Net.Names.Fire).OnServerEvent:Connect(function(player, payload)
		local ok, err = pcall(CombatService.handleFire, player, payload)
		if not ok then
			warn("[HardOut] Ошибка обработки выстрела: " .. tostring(err))
		end
	end)

	Net.get(Net.Names.Reload).OnServerEvent:Connect(function(player)
		-- Тут позже можно проверять реальный запас патронов в инвентаре.
		local state = getState(player)
		state.lastShotAt = math.max(state.lastShotAt, os.clock() - 1)
	end)

	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return CombatService
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000018"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">RaidSandbox</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	RaidSandbox.luau
	Заготовка "рейдового" слоя в духе Таркова — пока без бэкенда, но с реальными
	формулами. Всё пишется в атрибуты игрока, поэтому клиент может читать их
	без отдельной сети:

		HardOutWeight       — вес снаряжения, кг
		HardOutSpeedMult    — множитель скорости от веса и состояния
		HardOutSpreadMult   — множитель разброса от веса
		HardOutStamina      — выносливость 0..100

	Команды в чате (для проверки ощущений):
		/weight 25     вес снаряжения
		/fracture      переключить перелом
		/bleed         переключить кровотечение
		/stamina 40    выносливость
		/reset         сброс

	Когда дойдёшь до настоящих рейдов — это место, куда вешать инвентарь,
	сохранения и лут. Формулы уже вынесены в чистые функции и покрыты тестами.
]]

local Players = game:GetService("Players")

local RaidSandbox = {}

-- 0 кг -> 1.0, 40 кг -> ~0.62 (тяжёлый рюкзак реально замедляет).
local WEIGHT_SPEED_FALLOFF = 0.0095
-- Вес добавляет разброс: 50 кг -> +35%.
local WEIGHT_SPREAD_FACTOR = 0.35

type Condition = {
	bleeding: boolean?,
	fractured: boolean?,
	stamina: number?,
}

local conditions: { [Player]: Condition } = {}

--[[ Множитель скорости от веса (кг). ]]
function RaidSandbox.speedMultiplier(weightKg: number): number
	local weight = math.max(tonumber(weightKg) or 0, 0)
	return math.clamp(1 - weight * WEIGHT_SPEED_FALLOFF, 0.45, 1)
end

--[[ Множитель разброса от веса. ]]
function RaidSandbox.spreadMultiplier(weightKg: number): number
	local weight = math.clamp(tonumber(weightKg) or 0, 0, 50)
	return 1 + (weight / 50) * WEIGHT_SPREAD_FACTOR
end

--[[ Множитель скорости от состояний (перелом/кровотечение/усталость). ]]
function RaidSandbox.conditionMultiplier(condition: Condition?): number
	if not condition then
		return 1
	end
	local multiplier = 1
	if condition.fractured then
		multiplier *= 0.55
	end
	if condition.bleeding then
		multiplier *= 0.85
	end
	local stamina = condition.stamina
	if type(stamina) == "number" and stamina < 30 then
		multiplier *= 0.8
	end
	return multiplier
end

local function publish(player: Player, condition: Condition?)
	local weight = player:GetAttribute("HardOutWeight") or 0
	player:SetAttribute(
		"HardOutSpeedMult",
		RaidSandbox.speedMultiplier(weight) * RaidSandbox.conditionMultiplier(condition)
	)
	player:SetAttribute("HardOutSpreadMult", RaidSandbox.spreadMultiplier(weight))
	player:SetAttribute("HardOutStamina", (condition and condition.stamina) or 100)
end

--[[ Задать вес снаряжения. ]]
function RaidSandbox.setLoadout(player: Player, weightKg: number)
	player:SetAttribute("HardOutWeight", math.clamp(tonumber(weightKg) or 0, 0, 80))
	publish(player, conditions[player])
end

--[[ Задать состояния. ]]
function RaidSandbox.applyCondition(player: Player, condition: Condition)
	conditions[player] = condition
	publish(player, condition)
end

function RaidSandbox.getCondition(player: Player): Condition?
	return conditions[player]
end

--[[ Сброс. ]]
function RaidSandbox.reset(player: Player)
	conditions[player] = nil
	player:SetAttribute("HardOutWeight", 0)
	publish(player, nil)
end

local function toggle(player: Player, key: string): boolean
	local condition = conditions[player] or {}
	condition[key] = not condition[key]
	RaidSandbox.applyCondition(player, condition)
	return condition[key] == true
end

local function handleCommand(player: Player, message: string)
	local command, argument = string.match(message, "^/(%a+)%s*(.*)$")
	if not command then
		return
	end
	command = string.lower(command)

	if command == "weight" then
		local weight = tonumber(argument) or 0
		RaidSandbox.setLoadout(player, weight)
	elseif command == "fracture" or command == "fractured" then
		toggle(player, "fractured")
	elseif command == "bleed" or command == "bleeding" then
		toggle(player, "bleeding")
	elseif command == "stamina" then
		local condition = conditions[player] or {}
		condition.stamina = math.clamp(tonumber(argument) or 100, 0, 100)
		RaidSandbox.applyCondition(player, condition)
	elseif command == "reset" then
		RaidSandbox.reset(player)
	end
end

function RaidSandbox.initialize()
	local function bindPlayer(player: Player)
		RaidSandbox.reset(player)
		player.Chatted:Connect(function(message)
			handleCommand(player, message)
		end)
	end

	for _, player in Players:GetPlayers() do
		task.spawn(bindPlayer, player)
	end
	Players.PlayerAdded:Connect(bindPlayer)

	Players.PlayerRemoving:Connect(function(player)
		conditions[player] = nil
	end)
end

return RaidSandbox
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000019"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">SampleWeapon</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	SampleWeapon.luau
	Демо-оружие "HYBRID-9": процедурная заготовка из Parts, повторяющая ровно тот
	контракт, который ждёт стенд:

		Model "HYBRID-9"
		  ├─ Body, Slide, Barrel, Grip, Magazine, SightRear...  (MeshPart/Part)
		  └─ Attachments (Folder)
		       ├─ Grip    Attachment  — точка хвата правой рукой
		       ├─ Support Attachment  — точка поддержки левой рукой
		       ├─ Muzzle  Attachment  — срез ствола (вспышка/трассер)
		       └─ Sight   Attachment  — точка прицеливания (ADS)

	Зачем нужен: проверить стенд ДО того, как появится твоя модель, и увидеть,
	как правильно расставлены сокеты и оси. Удалить можно одной строкой в
	init.server.luau (HardOut создаст его только если папка пустая).

	Когда положишь свою модель — демо можно убрать: Config.Weapons.AutoSpawnSample = false.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SampleWeapon = {}

local function part(name, size, cframe, color, material, parent)
	local instance = Instance.new("Part")
	instance.Name = name
	instance.Size = size
	instance.CFrame = cframe
	instance.Color = color
	instance.Material = material or Enum.Material.Metal
	instance.Anchored = false
	instance.CanCollide = false
	instance.CanQuery = false
	instance.CanTouch = false
	instance.Massless = true
	instance.Parent = parent
	return instance
end

local function attachment(name, cframe, parent)
	local instance = Instance.new("Attachment")
	instance.Name = name
	instance.CFrame = cframe
	instance.Parent = parent
	return instance
end

--[[ Собирает модель демо-оружия. Оси: ствол = -Z, верх = +Y. ]]
function SampleWeapon.build()
	local model = Instance.new("Model")
	model.Name = "HYBRID-9"

	local METAL = Color3.fromRGB(52, 54, 56)
	local DARK = Color3.fromRGB(30, 31, 33)
	local POLYMER = Color3.fromRGB(43, 45, 42)
	local ACCENT = Color3.fromRGB(120, 96, 60)

	-- Корпус (ресивер). Ось Z = длина оружия (ствол смотрит в -Z), ось Y = верх.
	local body = part("Body", Vector3.new(0.34, 0.42, 1.9), CFrame.new(0, 0, 0), METAL, nil, model)

	-- Ствол.
	part("Barrel", Vector3.new(0.16, 0.16, 1.15), CFrame.new(0, 0.06, -1.45), DARK, nil, model)

	-- Цевьё (сюда встаёт левая рука).
	part("Handguard", Vector3.new(0.3, 0.3, 0.85), CFrame.new(0, -0.02, -1.0), POLYMER, nil, model)

	-- Затвор/кожух сверху.
	part("Slide", Vector3.new(0.3, 0.16, 1.3), CFrame.new(0, 0.28, -0.2), METAL, nil, model)

	-- Пистолетная рукоять, наклонена назад.
	part(
		"GripPart",
		Vector3.new(0.28, 0.75, 0.38),
		CFrame.new(0, -0.5, 0.62) * CFrame.Angles(math.rad(-15), 0, 0),
		POLYMER,
		nil,
		model
	)

	-- Магазин.
	part(
		"MagazinePart",
		Vector3.new(0.24, 0.62, 0.3),
		CFrame.new(0, -0.75, 0.68) * CFrame.Angles(math.rad(-10), 0, 0),
		DARK,
		nil,
		model
	)

	-- Приклад.
	part("Stock", Vector3.new(0.22, 0.34, 0.9), CFrame.new(0, -0.06, 1.35), POLYMER, nil, model)
	part("StockPad", Vector3.new(0.26, 0.46, 0.12), CFrame.new(0, -0.08, 1.82), DARK, nil, model)

	-- Прицельные: задний + мушка.
	part("RearSight", Vector3.new(0.2, 0.12, 0.1), CFrame.new(0, 0.42, 0.24), ACCENT, nil, model)
	part("FrontSight", Vector3.new(0.09, 0.16, 0.08), CFrame.new(0, 0.32, -1.86), ACCENT, nil, model)

	-- Спусковая скоба.
	part("TriggerGuard", Vector3.new(0.2, 0.1, 0.42), CFrame.new(0, -0.3, 0.26), DARK, nil, model)

	model.PrimaryPart = body

	-- ВАЖНО: сокеты. Это единственное, что обязательно для стенда.
	local sockets = Instance.new("Folder")
	sockets.Name = "Attachments"
	sockets.Parent = model

	-- Grip: где находится правая ладонь. Оружие смотрит в -Z, верх +Y.
	attachment("Grip", CFrame.new(0, -0.38, 0.62) * CFrame.Angles(math.rad(-8), 0, 0), sockets)

	-- Support: куда встаёт левая рука (цевьё).
	attachment("Support", CFrame.new(0, -0.12, -1.02), sockets)

	-- Muzzle: срез ствола, ось -Z смотрит вперёд. Отсюда вспышка и трассер.
	attachment("Muzzle", CFrame.new(0, 0.06, -2.06), sockets)

	-- Sight: точка, куда "смотрит" глаз в ADS.
	attachment("Sight", CFrame.new(0, 0.42, 0.24), sockets)

	-- Статы прямо на модели (перекрывают пресет WeaponConfig).
	model:SetAttribute("RoundsPerMinute", 700)
	model:SetAttribute("Damage", 36)
	model:SetAttribute("MagazineSize", 30)
	model:SetAttribute("ReloadTime", 2.4)
	model:SetAttribute("Auto", true)
	model:SetAttribute("AmmoType", "9x19")
	model:SetAttribute("AdsFov", 48)
	model:SetAttribute("Spread", 1.5)
	model:SetAttribute("SpreadAim", 0.2)
	model:SetAttribute("Recoil", 1.0)
	model:SetAttribute("RecoilVisual", 1.0)
	model:SetAttribute("Range", 300)

	return model
end

--[[ Кладёт демо-оружие в папку, если она пуста. ]]
function SampleWeapon.install(folder)
	if not folder then
		return nil
	end
	for _, child in folder:GetChildren() do
		if child:IsA("Model") or child:IsA("Tool") then
			return nil -- у пользователя уже есть своё оружие, не мешаем
		end
	end

	local model = SampleWeapon.build()
	model.Parent = folder
	return model
end

return SampleWeapon
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001A"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">TestRange</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	TestRange.luau
	Тестовый полигон, который строится кодом при старте сервера.

	Состав:
	  * бетонный пол 120x120 + стены + потолочный навес (закрытая коробка),
	  * точка спавна игрока,
	  * 3 манекена с Humanoid на 10 / 25 / 50 метров (проверка зон урона),
	  * ящики-укрытия и разметка дистанций,
	  * лампы, чтобы внутри не было темно.

	Выключить и использовать свой уровень: Config.TestRange.Enabled = false
	(или удалить Workspace.TestRange и поставить false).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HardOut"):WaitForChild("Config"))

local TestRange = {}

local FLOOR_COLOR = Color3.fromRGB(56, 55, 51)
local WALL_COLOR = Color3.fromRGB(43, 42, 39)
local SPAN = 120
local WALL_HEIGHT = 22

local function newPart(name, size, cframe, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Concrete
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

--[[ Манекен: части + Humanoid, чтобы серверный код наносил честный урон. ]]
local function buildMannequin(parent, position, label)
	local model = Instance.new("Model")
	model.Name = "Mannequin_" .. label

	local torsoColor = Color3.fromRGB(68, 82, 70)
	local limbColor = Color3.fromRGB(50, 58, 52)
	local skinColor = Color3.fromRGB(212, 196, 168)

	local root = newPart(
		"HumanoidRootPart",
		Vector3.new(1, 1, 1),
		CFrame.new(position + Vector3.new(0, 3.6, 0)),
		torsoColor,
		Enum.Material.Fabric,
		model
	)
	root.Transparency = 1

	local torso = newPart(
		"Torso",
		Vector3.new(1.8, 2.4, 1),
		CFrame.new(position + Vector3.new(0, 3.6, 0)),
		torsoColor,
		Enum.Material.Fabric,
		model
	)
	local head = newPart(
		"Head",
		Vector3.new(1.1, 1.1, 1.1),
		CFrame.new(position + Vector3.new(0, 5.4, 0)),
		skinColor,
		Enum.Material.SmoothPlastic,
		model
	)
	local leftArm = newPart(
		"LeftArm",
		Vector3.new(0.6, 2.2, 0.6),
		CFrame.new(position + Vector3.new(1.2, 3.6, 0)),
		limbColor,
		Enum.Material.Fabric,
		model
	)
	local rightArm = newPart(
		"RightArm",
		Vector3.new(0.6, 2.2, 0.6),
		CFrame.new(position + Vector3.new(-1.2, 3.6, 0)),
		limbColor,
		Enum.Material.Fabric,
		model
	)
	local leftLeg = newPart(
		"LeftLeg",
		Vector3.new(0.7, 2.3, 0.7),
		CFrame.new(position + Vector3.new(0.45, 1.15, 0)),
		limbColor,
		Enum.Material.Fabric,
		model
	)
	local rightLeg = newPart(
		"RightLeg",
		Vector3.new(0.7, 2.3, 0.7),
		CFrame.new(position + Vector3.new(-0.45, 1.15, 0)),
		limbColor,
		Enum.Material.Fabric,
		model
	)

	for _, part in { torso, head, leftArm, rightArm, leftLeg, rightLeg } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = root
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(150, 44)
	billboard.StudsOffset = Vector3.new(0, 2.3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 400
	billboard.Parent = head

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.Code
	text.TextSize = 16
	text.TextColor3 = Color3.fromRGB(232, 228, 216)
	text.Text = label
	text.Parent = billboard

	local health = Instance.new("TextLabel")
	health.Name = "Health"
	health.Size = UDim2.new(1, 0, 1, 0)
	health.Position = UDim2.fromOffset(0, 20)
	health.BackgroundTransparency = 1
	health.Font = Enum.Font.Code
	health.TextSize = 13
	health.TextColor3 = Color3.fromRGB(200, 170, 110)
	health.Text = "100"
	health.Parent = billboard

	model.PrimaryPart = root
	model.Parent = parent

	-- Обновление цифры здоровья + бесконечный респавн для тестов.
	local function updateHealth()
		health.Text = tostring(math.max(0, math.floor(humanoid.Health)))
	end
	humanoid.HealthChanged:Connect(updateHealth)

	humanoid.Died:Connect(function()
		task.delay(2.5, function()
			if model.Parent then
				humanoid.Health = humanoid.MaxHealth
			end
		end)
	end)

	return model
end

function TestRange.build()
	if not Config.TestRange.Enabled then
		return nil
	end

	local existing = workspace:FindFirstChild("TestRange")
	if existing then
		return existing
	end

	local map = Instance.new("Model")
	map.Name = "TestRange"
	map:SetAttribute("HardOutMap", true)

	local half = SPAN / 2

	newPart("Floor", Vector3.new(SPAN, 2, SPAN), CFrame.new(0, -1, 0), FLOOR_COLOR, Enum.Material.Concrete, map)
	newPart("WallNorth", Vector3.new(SPAN, WALL_HEIGHT, 2), CFrame.new(0, WALL_HEIGHT / 2, -half), WALL_COLOR, nil, map)
	newPart("WallSouth", Vector3.new(SPAN, WALL_HEIGHT, 2), CFrame.new(0, WALL_HEIGHT / 2, half), WALL_COLOR, nil, map)
	newPart("WallEast", Vector3.new(2, WALL_HEIGHT, SPAN), CFrame.new(half, WALL_HEIGHT / 2, 0), WALL_COLOR, nil, map)
	newPart("WallWest", Vector3.new(2, WALL_HEIGHT, SPAN), CFrame.new(-half, WALL_HEIGHT / 2, 0), WALL_COLOR, nil, map)
	newPart("Roof", Vector3.new(SPAN, 1, SPAN), CFrame.new(0, WALL_HEIGHT, 0), Color3.fromRGB(34, 34, 32), nil, map)

	-- Мишени на разных дистанциях.
	buildMannequin(map, Vector3.new(-7, 0, 26), "10 м")
	buildMannequin(map, Vector3.new(6, 0, 10), "25 м")
	buildMannequin(map, Vector3.new(0, 0, -14), "50 м")
	buildMannequin(map, Vector3.new(-24, 0, -20), "60 м")

	-- Укрытия.
	local crates = {
		{ Vector3.new(-16, 1.5, 34), Vector3.new(4, 3, 4) },
		{ Vector3.new(13, 2, 32), Vector3.new(5, 4, 5) },
		{ Vector3.new(-22, 1, 14), Vector3.new(3, 2, 3) },
		{ Vector3.new(19, 1.5, 12), Vector3.new(4, 3, 4) },
		{ Vector3.new(-6, 1, -4), Vector3.new(6, 2, 2) },
		{ Vector3.new(22, 2.5, -26), Vector3.new(5, 5, 5) },
	}
	for index, crate in crates do
		newPart(
			"Crate" .. index,
			crate[2],
			CFrame.new(crate[1]),
			Color3.fromRGB(74, 60, 42),
			Enum.Material.WoodPlanks,
			map
		)
	end

	-- Разметка дистанций от точки спавна (z = 38).
	local spawnZ = 38
	for _, distance in { 10, 25, 50 } do
		local marker = newPart(
			"Marker" .. distance,
			Vector3.new(20, 0.1, 0.35),
			CFrame.new(0, 0.06, spawnZ - distance),
			Color3.fromRGB(186, 152, 88),
			Enum.Material.Neon,
			map
		)
		marker.CanCollide = false

		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(70, 24)
		billboard.StudsOffset = Vector3.new(0, 1, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = marker

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.Code
		text.TextSize = 13
		text.TextColor3 = Color3.fromRGB(214, 184, 124)
		text.Text = distance .. " м"
		text.Parent = billboard
	end

	-- Свет.
	for index, position in { Vector3.new(-30, 18, -30), Vector3.new(30, 18, -30), Vector3.new(0, 18, 30) } do
		local lamp = Instance.new("Part")
		lamp.Name = "Lamp" .. index
		lamp.Size = Vector3.new(4, 0.4, 4)
		lamp.CFrame = CFrame.new(position)
		lamp.Anchored = true
		lamp.CanCollide = false
		lamp.CanQuery = false
		lamp.Material = Enum.Material.Neon
		lamp.Color = Color3.fromRGB(255, 244, 214)
		lamp.Parent = map

		local light = Instance.new("PointLight")
		light.Brightness = 2
		light.Range = 48
		light.Color = Color3.fromRGB(255, 240, 210)
		light.Parent = lamp
	end

	-- Спавн: невидимый, но стоит на полу, чтобы персонаж не падал с высоты.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "Spawn"
	spawnLocation.Size = Vector3.new(12, 0.6, 12)
	spawnLocation.CFrame = CFrame.new(0, 0.3, spawnZ)
	spawnLocation.Anchored = true
	spawnLocation.CanCollide = false
	spawnLocation.Transparency = 1
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = map

	map.Parent = workspace

	-- Страховка: если персонаж каким-то образом оказался под полом (спавн в
	-- пустоте, старый сейв), возвращаем его в зону. Это же спасает от "падаю".
	local Players = game:GetService("Players")
	local floorTop = 0
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if not root then
				return
			end
			task.delay(1.5, function()
				if root.Parent and root.Position.Y < floorTop - 15 then
					root.CFrame = CFrame.new(0, 6, 38)
				end
			end)
		end)
	end)

	return map
end

return TestRange
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000000000000000000000000002B"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">0.5</float><float name="CameraMinZoomDistance">0.5</float><float name="CharacterWalkSpeed">8</float><float name="CharacterJumpPower">42</float><bool name="CharacterUseJumpPower">true</bool><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000002A"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000001D"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">ClientBoot</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	HardOut — клиентская точка входа.
	Запускает HUD, контроллер игрока (камера + руки/ноги) и оружие.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Config = require(ReplicatedStorage:WaitForChild("HardOut"):WaitForChild("Config"))

-- Курсор: без системной стрелки в центре экрана и без "свободной" мыши.
if Config.Camera.HideCursor then
	UserInputService.MouseIconEnabled = false
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end

-- Камера от первого лица (скриптовая, наша).
player.CameraMode = Enum.CameraMode.LockFirstPerson

-- Папка Modules — рядом с ClientBoot (внутри StarterPlayerScripts).
local Modules = script.Parent and script.Parent:FindFirstChild("Modules")
if not Modules then
	warn(
		"[HardOut] НЕ НАЙДЕНА папка Modules рядом с ClientBoot (ожидается внутри StarterPlayerScripts)."
	)
	return
end
local CharacterSetup = require(Modules:WaitForChild("CharacterSetup"))
local CharacterTransparency = require(Modules:WaitForChild("CharacterTransparency"))
local Hud = require(Modules:WaitForChild("Hud"))
local PlayerController = require(Modules:WaitForChild("PlayerController"))
local WeaponController = require(Modules:WaitForChild("WeaponController"))
local Tracers = require(Modules:WaitForChild("Tracers"))

CharacterSetup.start()

-- Тело (руки/ноги/живот) должно быть видно от первого лица.
CharacterTransparency.initialize()

local hud = Hud.new()
if Config.Camera.ShowCrosshair == false then
	hud:setCrosshairVisible(false)
end

local controller = PlayerController.new()
controller.hud = hud
controller:start()

local weaponController = WeaponController.new(controller)

Tracers.initialize()

print("[HardOut] Клиент готов: вид от первого лица, руки/ноги, HUD.")
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000000000029"><Properties><BinaryString name="AttributesSerialize"></BinaryString><string name="Name">Modules</string><int64 name="SourceAssetId">-1</int64><BinaryString name="Tags"></BinaryString></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000001E"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Camera</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	Camera.luau
	Камера от первого лица, полностью управляемая скриптом.

	Почему своя камера, а не дефолтная:
	  * отдача идёт в прицел и возвращается плавно, а не дёргает персонажа;
	  * ADS плавно меняет FOV и приближает оружие;
	  * наклон в стрейфе и покачивание головы.

	Важно: углы обзора (lookAngles) хранятся здесь и НЕ зависят от Humanoid,
	поэтому не возникает петли "камера -> поворот персонажа -> камера".
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))
local Spring = require(HardOut:WaitForChild("Weapon"):WaitForChild("Spring"))
local Recoil = require(HardOut:WaitForChild("Weapon"):WaitForChild("Recoil"))

local Camera = {}
Camera.__index = Camera

-- Чувствительность: чуть ниже роблоксовой, как в "медленных" шутерах.
local LOOK_SENSITIVITY = 0.0026

function Camera.new(player)
	local self = setmetatable({}, Camera)
	self.player = player
	self.recoil = Recoil.new()
	self.fovSpring = Spring.new(Config.Camera.BaseFov, 160, 18)
	self.aimSpring = Spring.new(0, 200, 22)
	self.lookAngles = Vector2.new(0, 0) -- yaw/pitch в градусах
	self.speed = 0
	self.leanTarget = 0
	self.leanAngle = 0
	self.bobPhase = 0
	self.shake = 0
	self.aimed = false
	self.aimFactor = 0
	self.lastDelta = Vector2.zero
	self.lastCFrame = CFrame.new(0, 0, 0)
	self.smoothedAngles = Vector2.new(0, 0)
	self.shakePhase = 0
	return self
end

--[[ Чтение мыши + инерция для оружия. ]]
function Camera:readMouse()
	local delta = UserInputService:GetMouseDelta()
	self.lastDelta = delta
	local sensitivity = LOOK_SENSITIVITY * 57.2958
	self.lookAngles = Vector2.new(
		self.lookAngles.X - delta.X * sensitivity,
		math.clamp(self.lookAngles.Y - delta.Y * sensitivity, -85, 85)
	)
	self.recoil:AddLook(delta.X, delta.Y)
end

function Camera:addRecoil(yaw, pitch, visualMult)
	self.recoil:AddShot(yaw, pitch, visualMult)
	local strength = Config.Camera.ShakeScale or 0.35
	self.shake = math.min(self.shake + 0.35 * (visualMult or 1) * strength, 1.6 * strength)
end

function Camera:setAiming(isAiming, adsFov)
	self.aimed = isAiming
	self.aimSpring:SetTarget(isAiming and 1 or 0)
	self.fovSpring:SetTarget(isAiming and (adsFov or Config.Camera.BaseFov) or Config.Camera.BaseFov)
end

function Camera:setMovement(speed, isCrouching)
	self.speed = speed
	self.isCrouching = isCrouching
end

function Camera:setLean(lean)
	self.leanTarget = lean
end

--[[ Сброс в начальное положение (респавн). ]]
function Camera:reset()
	self.recoil:Reset()
	self.shake = 0
	self.leanAngle = 0
	self.bobPhase = 0
end

--[[ Возвращает актуальный CFrame и FOV. ]]
function Camera:update(dt)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	local character = self.player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return self.lastCFrame, camera.FieldOfView
	end

	local recoilYaw, recoilPitch = self.recoil:Step(dt)
	self.shake *= math.exp(-dt * 10)
	self.shakePhase = (self.shakePhase or 0) + dt * 60
	local shakePitch = math.sin(self.shakePhase) * self.shake * 0.4
	local shakeRoll = math.cos(self.shakePhase * 0.63) * self.shake * 0.25

	local bob = Config.Camera.HeadBob
	local bobY, bobRoll, bobX = 0, 0, 0
	if bob.Enabled and self.speed > 0.5 then
		self.bobPhase += dt * (bob.Frequency * math.sqrt(self.speed / Config.Movement.WalkSpeed)) * math.pi * 2
		local amount = math.clamp(self.speed / Config.Movement.WalkSpeed, 0, 1.6)
		bobY = math.abs(math.sin(self.bobPhase)) * bob.Amplitude * amount
		bobRoll = math.sin(self.bobPhase) * 0.5 * amount
		bobX = math.cos(self.bobPhase) * bob.Amplitude * 0.5 * amount
	end

	self.leanAngle += (self.leanTarget * Config.Camera.LeanAngle - self.leanAngle) * math.clamp(dt * 10, 0, 1)

	local crouchOffset = self.isCrouching and -0.5 or 0
	-- Камера чуть впереди головы: иначе она окажется внутри тела, и торс/живот
	-- не будут видны при взгляде вниз (а near-plane срежет шею).
	local forward = Config.Camera.EyeForward or 0.6
	local ahead = Vector3.new(-math.sin(math.rad(self.smoothedAngles.X)), 0, -math.cos(math.rad(self.smoothedAngles.X)))
	local origin = head.Position + Config.Camera.EyeOffset + ahead * forward + Vector3.new(bobX, bobY + crouchOffset, 0)

	-- Мягкое сглаживание: камера чуть "догоняет" мышь (не резкие рывки).
	local smooth = Config.Camera.Smoothing or 0.35
	local targetAngles = Vector2.new(self.lookAngles.X - recoilYaw, self.lookAngles.Y - recoilPitch)
	if smooth > 0 then
		self.smoothedAngles =
			self.smoothedAngles:Lerp(targetAngles, math.clamp(dt * (1 / math.max(smooth, 0.02)), 0, 1))
	else
		self.smoothedAngles = targetAngles
	end

	local rotation = CFrame.fromOrientation(
		math.rad(self.smoothedAngles.Y + shakePitch),
		math.rad(self.smoothedAngles.X),
		math.rad(self.leanAngle + bobRoll + shakeRoll)
	)

	local cameraCFrame = CFrame.new(origin) * rotation
	camera.CFrame = cameraCFrame
	camera.FieldOfView = self.fovSpring:Step(dt)
	self.aimFactor = self.aimSpring:Step(dt)
	self.lastCFrame = cameraCFrame
	return cameraCFrame, camera.FieldOfView
end

--[[ Куда сейчас смотрит игрок (для стрельбы и привязок). ]]
function Camera:getLookRay()
	return self.lastCFrame.Position, self.lastCFrame.LookVector
end

function Camera:getAimFactor()
	return self.aimFactor
end

return Camera
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000001F"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">CharacterRig</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	CharacterRig.luau
	"Руки и ноги от первого лица" через НАСТОЯЩЕГО персонажа.

	Почему так лучше процедурных частей:
	  * руки и ноги — это твои аватары/скины, а не серые бруски;
	  * работают штатные анимации Roblox (idle / walk / run / jump) — «анимации
	    персонажа», как ты и просил;
	  * оружие цепляется к настоящей кисти (RightHand в R15, Right Arm в R6),
	    поэтому оно честно ездит вместе с анимацией рук.

	Что делает модуль:
	  1. Прячет голову и головные аксессуары (иначе они закрывают обзор изнутри).
	  2. Включает штатные анимации (в CharacterSetup они больше не отключаются).
	  3. Даёт стабильный интерфейс для WeaponHolder/WeaponController:
	         rig.handPart   — часть-кисть (BasePart)
	         rig:getGripCFrame() — CFrame хвата оружия в системе кисти
	         rig:setState / update / destroy
	4. Подстраховывает "провал камеры в голову": голова невидима локально,
	     поэтому near-plane не режет кадр.

	Переключить на процедурные руки: Config.ViewModel.Mode = "Procedural".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))

local CharacterRig = {}
CharacterRig.__index = CharacterRig

local HEAD_NAMES = {
	Head = true,
	["head"] = true,
}

local function isAccessory(instance: Instance): boolean
	-- Шляпы/маски/очки — это Accessory с рукой-обёрткой; прячем целиком.
	return instance:IsA("Accessory") or instance:IsA("Hat")
end

local function findHand(character: Instance): BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	for _, handName in Config.Weapons.HandNames do
		local part = character:FindFirstChild(handName)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	-- На всякий случай: первая рука, которую найдём.
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and string.find(part.Name, "Arm") then
			return part
		end
	end
	return nil
end

function CharacterRig.new(character: Instance)
	local self = setmetatable({}, CharacterRig)
	self.character = character
	self.humanoid = character:FindFirstChildOfClass("Humanoid")
	self.enabled = Config.ViewModel.Mode == "Character"

	self.hidden = {}
	self:prepare()
	return self
end

--[[ Видимостью тела управляет CharacterTransparency: она показывает руки/ноги/торс
     и прячет только голову. Здесь ничего не трогаем, чтобы не спорить с ней. ]]
function CharacterRig:hideHead()
	-- намеренно пусто: см. CharacterTransparency.luau
end

--[[ Штатные анимации должны играть: это и есть "анимации персонажа". ]]
function CharacterRig:prepare()
	self.handPart = findHand(self.character)

	local animate = self.character:FindFirstChild("Animate")
	if animate and animate:IsA("LocalScript") then
		animate.Disabled = false
	end

	if self.humanoid then
		self.humanoid.AutoRotate = false -- поворотом управляет PlayerController
	end

	if not self.handPart then
		warn(
			"[HardOut] Не нашёл кисть персонажа (RightHand / Right Arm) — оружие не надеть."
		)
	end
end

--[[ CFrame, к которому цепляется оружие (в системе координат кисти). ]]
function CharacterRig:getGripCFrame(): CFrame
	return Config.Weapons.HandGripCFrame
end

--[[ Совместимость с PlayerController: состояние движения не нужно, но пусть будет. ]]
function CharacterRig:setState(_state: any)
	-- Настоящий персонаж анимируется собственными треками, руками управлять не надо.
end

function CharacterRig:addLook(_deltaX: number, _deltaY: number)
	-- Инерция рук от мыши: у штатных анимаций её нет. При желании можно добавить
	-- сюда лёгкий поворот Motor6D "Right Shoulder", но это ломает R15-анимации.
end

--[[ Вызывается каждый кадр. Пока делать нечего — позу ведёт Animator персонажа. ]]
function CharacterRig:update(_dt: number)
	if not self.enabled then
		return
	end
	-- Кисть могла пересоздаться (например, после смены аватара).
	if not self.handPart or not self.handPart.Parent then
		self.handPart = findHand(self.character)
	end
end

function CharacterRig:destroy()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	-- Возвращаем прозрачность (на случай смены режима на процедурный).
	for part in pairs(self.hidden) do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end
	table.clear(self.hidden)
end

return CharacterRig
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000020"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">CharacterSetup</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	CharacterSetup.luau
	Приводит стандартный персонаж в состояние, нужное для FPS-стенда:

	  * отключает дефолтные контроллы Roblox (они перехватывают мышь,
	    зумят камеру и двигают персонажа так, как нам не надо);
	  * гасит авто-поворот персонажа (у нас своя камера);
	  * НЕ выключает анимации персонажа: они нужны, чтобы руки/ноги в кадре
	    двигались как у живого персонажа;
	  * убирает прыжок по умолчанию с пробела и ставит свой (с задержкой).

	Здесь же — заготовка под будущий сетевой вид рук других игроков.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local CharacterSetup = {}

local function disableDefaultControls()
	-- Эти скрипты созданы движком в PlayerScripts. Важно: PlayerModule —
	-- это ModuleScript, у него НЕТ свойства Disabled (попытка его выставить
	-- падает с ошибкой). Поэтому PlayerModule мы НЕ отключаем: он нужен для
	-- работы камеры/контроллов, а его "скрытие тела в первом лице" мы
	-- перебиваем каждый кадр в CharacterTransparency.
	local playerScripts = player:WaitForChild("PlayerScripts")

	local function disable(instance)
		-- Отключаем только то, что реально имеет Disabled (LocalScript/Script).
		if instance:IsA("LocalScript") or instance:IsA("Script") then
			pcall(function()
				instance.Disabled = true
			end)
		end
	end

	-- ControlModule/CameraModule лежат внутри PlayerModule и обычно тоже
	-- ModuleScript'ы — их не трогаем (см. комментарий выше).
	for _, name in { "ControlModule", "CameraModule" } do
		local existing = playerScripts:FindFirstChild(name)
		if existing then
			disable(existing)
		end
	end
end

local function prepareCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")

	humanoid.AutoRotate = false
	humanoid.UseJumpPower = true
	-- Камера смотрит из головы: не даём роблоксу крутить персонажа за камерой.
	humanoid.CameraOffset = Vector3.new(0, 0, 0)

	-- Анимации НЕ отключаем: именно они двигают руки и ноги в кадре.
	-- (Если когда-нибудь понадобится "мёртвая" поза — Config.ViewModel.Mode = "Procedural".)

	-- Стандартные "прыжки" от Roblox ControlModule отключены вместе с модулем,
	-- поэтому прыжок обрабатывается в PlayerController.
	humanoid.WalkSpeed = 0 -- скоростью управляет PlayerController

	-- Тело должно быть видно: включаем (выключается в Config.ViewModel.ShowBody).
	local bodyParts = {
		"Head",
		"Torso",
		"UpperTorso",
		"LowerTorso",
		"Left Arm",
		"Right Arm",
		"Left Leg",
		"Right Leg",
		"LeftUpperArm",
		"RightUpperArm",
		"LeftUpperLeg",
		"RightUpperLeg",
		"LeftLowerArm",
		"RightLowerArm",
		"LeftLowerLeg",
		"RightLowerLeg",
		"LeftHand",
		"RightHand",
		"LeftFoot",
		"RightFoot",
	}
	for _, partName in bodyParts do
		local part = character:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			-- LocalTransparencyModifier — то, чем движок прячет тело в 1-м лице.
			part.LocalTransparencyModifier = part.Name == "Head" and 1 or 0
		end
	end
end

function CharacterSetup.start()
	disableDefaultControls()

	local function ensureAnimations(character)
		local animate = character:WaitForChild("Animate", 5)
		if animate and animate:IsA("LocalScript") then
			animate.Disabled = false
		end
	end

	if player.Character then
		task.spawn(prepareCharacter, player.Character)
		task.spawn(ensureAnimations, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		task.spawn(prepareCharacter, character)
		task.spawn(ensureAnimations, character)
	end)
end

return CharacterSetup
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000021"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">CharacterTransparency</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	CharacterTransparency.luau
	Отвечает за ВИДИМОСТЬ ТЕЛА своего персонажа от первого лица.

	Проблема, которую решает:
	  Дефолтный PlayerModule Roblox в первом лице сам делает части тела локально
	  прозрачными (через LocalTransparencyModifier) — и руки, и ноги, и торс
	  «исчезают». Поэтому изнутри видно только оружие, а тела нет.

	Решение:
	  * отключаем локальную прозрачность (Transparency = 0 у всех частей);
	  * глушим дефолтный скрипт, который её ставит (см. CharacterSetup);
	  * каждый кадр ПОДДЕРЖИВАЕМ видимость — на случай, если кто-то (движок,
	    другая система) снова выставит модификатор;
	  * прячем только голову и головные аксессуары, чтобы не загораживали обзор;
	  * вернуть штатное поведение: Config.ViewModel.HideBodyInFirstPerson = true.

	Почему LocalTransparencyModifier, а не Transparency:
	  модификатор виден только локально и не ломает вид персонажа для других
	  игроков/сервера.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))

local CharacterTransparency = {}

local player = Players.LocalPlayer

-- Части, которые нельзя прятать: в них камера и по ним стреляют.
local NEVER_HIDE = {
	HumanoidRootPart = true,
}

local function isHeadPart(instance: Instance): boolean
	if instance.Name == "Head" then
		return true
	end
	-- Шляпы, маски, очки: их части лежат внутри Accessory.
	return instance:FindFirstAncestorOfClass("Accessory") ~= nil
end

local function shouldHide(instance: BasePart): boolean
	if NEVER_HIDE[instance.Name] then
		return false
	end
	if not Config.ViewModel.HideHead then
		return false
	end
	return isHeadPart(instance)
end

local function applyTo(character: Instance)
	if not Config.ViewModel.ShowBody then
		return -- пользователь хочет штатное поведение Roblox (тело скрыто)
	end

	local function update(instance: Instance)
		if not instance:IsA("BasePart") then
			return
		end
		if shouldHide(instance) then
			instance.LocalTransparencyModifier = 1
		else
			-- Ключевая строка: возвращаем тело в кадр.
			instance.LocalTransparencyModifier = 0
		end
	end

	for _, descendant in character:GetDescendants() do
		update(descendant)
	end

	return update
end

function CharacterTransparency.initialize()
	local activeCharacter = nil
	local updatePart = nil
	local connections = {}

	local function clearConnections()
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
	end

	local function bind(character: Instance)
		clearConnections()
		activeCharacter = character
		updatePart = applyTo(character)
		if not updatePart then
			return
		end

		-- Новые части (загрузка аксессуаров, смена аватара, респавн частей).
		table.insert(
			connections,
			character.DescendantAdded:Connect(function(descendant)
				task.defer(updatePart, descendant)
			end)
		)
	end

	if player.Character then
		bind(player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		-- Ждём Humanoid: части появляются не мгновенно.
		character:WaitForChild("Humanoid", 10)
		task.wait(0.1)
		bind(character)
	end)

	-- Страховка: если движок снова спрятал тело — возвращаем видимость.
	-- (дешёвая проверка раз в кадр, только по нескольким ключевым частям)
	RunService.Heartbeat:Connect(function()
		if not updatePart or not activeCharacter or not activeCharacter.Parent then
			return
		end
		if not Config.ViewModel.ShowBody then
			return
		end
		for _, partName in
			{
				"Torso",
				"UpperTorso",
				"LowerTorso",
				"Left Arm",
				"Right Arm",
				"Left Leg",
				"Right Leg",
				"LeftUpperArm",
				"RightUpperArm",
				"LeftUpperLeg",
				"RightUpperLeg",
				"LeftLowerArm",
				"RightLowerArm",
				"LeftLowerLeg",
				"RightLowerLeg",
				"LeftFoot",
				"RightFoot",
				"LeftHand",
				"RightHand",
			}
		do
			local part = activeCharacter:FindFirstChild(partName)
			if part and part:IsA("BasePart") and part.LocalTransparencyModifier > 0.05 and not shouldHide(part) then
				part.LocalTransparencyModifier = 0
			end
		end
	end)
end

return CharacterTransparency
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000022"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">FirstPersonRig</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	FirstPersonRig.luau
	Руки и ноги от первого лица.

	Как устроено:
	  * Модель живёт в workspace.Camera (не в персонаже) — её нельзя сломать
	    физикой или чужими анимациями.
	  * Каждая рука = два сегмента (плечо-локоть, локоть-кисть), поза считается
	    через IK (shared/HardOut/ArmSolver). Отсюда живая поза вместо "палки".
	  * Правая кисть — точка хвата оружия (Attachment HandAnchor), к ней
	    привязывается модель оружия через Grip (см. WeaponHolder).
	  * Ноги идут в такт шагу и видны, если посмотреть вниз.

	Контракт замены на свои модели: docs/HANDS_AND_GUN.md.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))
local Animator = require(HardOut:WaitForChild("Animator"))
local ArmSolver = require(HardOut:WaitForChild("ArmSolver"))

local FirstPersonRig = {}
FirstPersonRig.__index = FirstPersonRig

local SKIN = Color3.fromRGB(226, 180, 145)
local SLEEVE = Color3.fromRGB(58, 62, 54)
local CLOTH = Color3.fromRGB(54, 58, 52)
local CLOTH_DARK = Color3.fromRGB(38, 40, 36)
local BOOT = Color3.fromRGB(26, 26, 26)

local LENGTHS = {
	UpperArm = 1.15,
	LowerArm = 1.15,
	UpperLeg = 1.35,
	LowerLeg = 1.35,
}

local THICKNESS = {
	Arm = 0.5,
	Leg = 0.62,
}

local CHEST_SIZE = Vector3.new(1.5, 1.0, 0.9)

local function newPart(name, size, color, parent, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

--[[ Ставит сегмент между двумя точками (ось Z = длина). ]]
local function placeSegment(part, from, to)
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.001 then
		part.CFrame = CFrame.lookAt(from + delta * 0.5, to) * CFrame.Angles(0, 0, 0)
		return
	end
	part.Size = Vector3.new(part.Size.X, part.Size.Y, length)
	part.CFrame = CFrame.lookAt(from + delta * 0.5, to)
end

function FirstPersonRig.new(camera)
	local self = setmetatable({}, FirstPersonRig)
	self.camera = camera
	self.animator = Animator.new(camera)
	self.enabled = Config.ViewModel.Enabled

	self.speed = 0
	self.isAiming = false
	self.isSprinting = false
	self.isCrouching = false
	self.lean = 0
	self.aimFactor = 0
	self.legPhase = 0
	self.equipped = false

	self:build()
	self:hideCharacterLimbs()
	return self
end

function FirstPersonRig:build()
	local model = Instance.new("Model")
	model.Name = "HardOutViewModel"

	local chest = newPart("Chest", CHEST_SIZE, CLOTH, model)
	local rightUpperArm =
		newPart("RightUpperArm", Vector3.new(THICKNESS.Arm, THICKNESS.Arm, LENGTHS.UpperArm), SLEEVE, model)
	local rightLowerArm =
		newPart("RightLowerArm", Vector3.new(THICKNESS.Arm * 0.92, THICKNESS.Arm * 0.92, LENGTHS.LowerArm), SKIN, model)
	local leftUpperArm =
		newPart("LeftUpperArm", Vector3.new(THICKNESS.Arm, THICKNESS.Arm, LENGTHS.UpperArm), SLEEVE, model)
	local leftLowerArm =
		newPart("LeftLowerArm", Vector3.new(THICKNESS.Arm * 0.92, THICKNESS.Arm * 0.92, LENGTHS.LowerArm), SKIN, model)

	local rightUpperLeg =
		newPart("RightUpperLeg", Vector3.new(THICKNESS.Leg, THICKNESS.Leg, LENGTHS.UpperLeg), CLOTH_DARK, model)
	local rightLowerLeg =
		newPart("RightLowerLeg", Vector3.new(THICKNESS.Leg, THICKNESS.Leg, LENGTHS.LowerLeg), CLOTH_DARK, model)
	local leftUpperLeg =
		newPart("LeftUpperLeg", Vector3.new(THICKNESS.Leg, THICKNESS.Leg, LENGTHS.UpperLeg), CLOTH_DARK, model)
	local leftLowerLeg =
		newPart("LeftLowerLeg", Vector3.new(THICKNESS.Leg, THICKNESS.Leg, LENGTHS.LowerLeg), CLOTH_DARK, model)

	local rightBoot = newPart("RightBoot", Vector3.new(0.62, 0.3, 0.95), BOOT, model, Enum.Material.Leather)
	local leftBoot = newPart("LeftBoot", Vector3.new(0.62, 0.3, 0.95), BOOT, model, Enum.Material.Leather)

	-- Кисть правой руки — точка хвата оружия.
	local handAnchor = Instance.new("Attachment")
	handAnchor.Name = "HandAnchor"
	handAnchor.Parent = rightLowerArm

	local supportAnchor = Instance.new("Attachment")
	supportAnchor.Name = "SupportAnchor"
	supportAnchor.Parent = leftLowerArm

	model.Parent = workspace.Camera

	self.model = model
	self.chest = chest
	self.rightUpperArm = rightUpperArm
	self.rightLowerArm = rightLowerArm
	self.leftUpperArm = leftUpperArm
	self.leftLowerArm = leftLowerArm
	self.rightUpperLeg = rightUpperLeg
	self.rightLowerLeg = rightLowerLeg
	self.leftUpperLeg = leftUpperLeg
	self.leftLowerLeg = leftLowerLeg
	self.rightBoot = rightBoot
	self.leftBoot = leftBoot
	self.handAnchor = handAnchor
	self.supportAnchor = supportAnchor
	self.handPart = rightLowerArm
	return model
end

--[[ Прячет руки/ноги настоящего персонажа, чтобы не торчали в кадре. ]]
function FirstPersonRig:hideCharacterLimbs()
	if not Config.ViewModel.HideCharacterLimbs then
		return
	end
	local HIDE = { ["Right Arm"] = true, ["Left Arm"] = true, ["Right Leg"] = true, ["Left Leg"] = true }

	local function apply(character)
		local function hide(instance)
			if instance:IsA("BasePart") and HIDE[instance.Name] then
				instance.LocalTransparencyModifier = 1
			end
		end
		for _, descendant in character:GetDescendants() do
			hide(descendant)
		end
		character.DescendantAdded:Connect(function(descendant)
			task.defer(hide, descendant)
		end)
	end

	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(function(character)
		task.defer(apply, character)
	end)
	if player.Character then
		task.defer(apply, player.Character)
	end
end

function FirstPersonRig:setState(state)
	self.speed = state.speed or 0
	self.isAiming = state.isAiming == true
	self.isSprinting = state.isSprinting == true
	self.isCrouching = state.isCrouching == true
	self.lean = state.lean or 0
	self.equipped = state.equipped ~= false
end

function FirstPersonRig:addLook(deltaX, deltaY)
	self.animator:AddLookDelta(Vector2.new(deltaX, deltaY))
end

--[[ Главный апдейт: ставит модель по камере и раскладывает конечности. ]]
function FirstPersonRig:update(dt)
	if not self.model or not self.enabled then
		return
	end

	local animation = self.animator:Step(dt, {
		speed = self.speed,
		isAiming = self.isAiming,
		isCrouching = self.isCrouching,
	})

	local cameraCFrame = self.camera.lastCFrame or workspace.CurrentCamera.CFrame
	local origin = cameraCFrame * Config.ViewModel.Offset * CFrame.new(0, -0.15, -0.15)

	local targetAim = self.isAiming and 1 or 0
	self.aimFactor += (targetAim - self.aimFactor) * math.clamp(dt * 12, 0, 1)

	-- Корпус: чуть повёрнут, покачивается вместе с камерой.
	self.chest.CFrame = origin
		* CFrame.new(animation.position)
		* CFrame.Angles(math.rad(animation.rotation.X), math.rad(animation.rotation.Y), math.rad(animation.rotation.Z))

	self:poseArms(dt, animation)
	self:poseLegs(dt)
end

--[[ Руки: IK от плеч к кистям. Правая кисть = место оружия. ]]
function FirstPersonRig:poseArms(dt, animation)
	local chestCFrame = self.chest.CFrame

	local aim = self.aimFactor
	local sprint = self.isSprinting and not self.isAiming
	local sprintFactor = 0
	if sprint then
		sprintFactor = 1
	end
	self.sprintFactor = (self.sprintFactor or 0) + (sprintFactor - (self.sprintFactor or 0)) * math.clamp(dt * 6, 0, 1)
	local sprintAmount = self.sprintFactor

	-- Плечи.
	local rightShoulder = chestCFrame * CFrame.new(0.45, 0.3, 0.1)
	local leftShoulder = chestCFrame * CFrame.new(-0.45, 0.3, 0.05)

	-- Кисти: при ADS подтягиваются к центру кадра, на бегу опускаются.
	local handForward = 0.95 - aim * 0.12 + sprintAmount * 0.35
	local handHeight = -0.12 + aim * 0.05 - sprintAmount * 0.5
	local handSpread = 0.22 - aim * 0.2

	local bobDown = math.min(animation.position.Y * 0.5, 0.15)

	-- Правая кисть — точка оружия. Левая тянется дальше вперёд (цевьё).
	local rightHand = chestCFrame * CFrame.new(handSpread, handHeight + bobDown, -handForward)
	local leftHand = chestCFrame * CFrame.new(-handSpread + 0.28, handHeight + bobDown - 0.04, -handForward - 0.42)

	-- IK правой руки.
	local rightJoint = ArmSolver.solve(
		rightShoulder.Position,
		rightHand.Position,
		LENGTHS.UpperArm,
		LENGTHS.LowerArm,
		Vector3.new(0.7, -1, -0.15)
	)
	placeSegment(self.rightUpperArm, rightShoulder.Position, rightJoint)
	placeSegment(self.rightLowerArm, rightJoint, rightHand.Position)

	-- Кисть на конце нижнего сегмента.
	self.handAnchor.CFrame = CFrame.new(0, 0, -LENGTHS.LowerArm * 0.5)

	-- IK левой руки (тянется к цевью).
	local leftJoint = ArmSolver.solve(
		leftShoulder.Position,
		leftHand.Position,
		LENGTHS.UpperArm,
		LENGTHS.LowerArm,
		Vector3.new(-0.7, -1, -0.15)
	)
	placeSegment(self.leftUpperArm, leftShoulder.Position, leftJoint)
	placeSegment(self.leftLowerArm, leftJoint, leftHand.Position)
	self.supportAnchor.CFrame = CFrame.new(0, 0, -LENGTHS.LowerArm * 0.5)
end

--[[ Ноги: бедра от корпуса, стопы по фазе шага. ]]
function FirstPersonRig:poseLegs(dt)
	local showLegs = Config.ViewModel.ShowLegs
	local parts = {
		self.rightUpperLeg,
		self.rightLowerLeg,
		self.leftUpperLeg,
		self.leftLowerLeg,
		self.rightBoot,
		self.leftBoot,
	}
	for _, part in parts do
		part.Transparency = showLegs and 0 or 1
	end
	if not showLegs then
		return
	end

	local chest = self.chest.CFrame
	local hipY = -CHEST_SIZE.Y * 0.5 - 0.05
	local hipRight = chest * CFrame.new(0.38, hipY, 0)
	local hipLeft = chest * CFrame.new(-0.38, hipY, 0)

	local walkRatio = math.clamp(self.speed / Config.Movement.WalkSpeed, 0, 1.8)
	self.legPhase += dt * walkRatio * 7.5
	local stride = 0.72 * math.min(walkRatio, 1.3)
	local lift = 0.42 * math.min(walkRatio, 1.2)

	local legLength = LENGTHS.UpperLeg + LENGTHS.LowerLeg

	-- Смещение стопы относительно бедра: вперёд/назад + подъём.
	local function footOffset(phase)
		local z = math.sin(phase) * stride
		local liftY = math.max(0, math.cos(phase)) * lift
		return Vector3.new(0, -legLength + 0.35 + liftY, z)
	end

	local footRight = hipRight * footOffset(self.legPhase)
	local footLeft = hipLeft * footOffset(self.legPhase + math.pi)

	local function placeLeg(hip, foot, upperPart, lowerPart, bootPart)
		local joint = ArmSolver.solve(
			hip.Position,
			foot.Position,
			LENGTHS.UpperLeg,
			LENGTHS.LowerLeg,
			Vector3.new(0, 0, -1) -- колено вперёд
		)
		placeSegment(upperPart, hip.Position, joint)
		placeSegment(lowerPart, joint, foot.Position)
		bootPart.CFrame =
			CFrame.lookAt(foot.Position + Vector3.new(0, 0.05, -0.18), foot.Position + Vector3.new(0, 0.05, -1))
	end

	placeLeg(hipRight, footRight, self.rightUpperLeg, self.rightLowerLeg, self.rightBoot)
	placeLeg(hipLeft, footLeft, self.leftUpperLeg, self.leftLowerLeg, self.leftBoot)
end

--[[ Интерфейс как у CharacterRig: часть-кисть и CFrame хвата. ]]
function FirstPersonRig:getGripCFrame(): CFrame
	return self.handAnchor.CFrame
end

function FirstPersonRig:getHandPart()
	return self.handAnchor.Parent
end

--[[ Мировая точка правой кисти. ]]
function FirstPersonRig:getHandCFrame()
	return self.rightLowerArm.CFrame * self.handAnchor.CFrame
end

function FirstPersonRig:setVisible(isVisible)
	if self.model then
		self.model.Parent = isVisible and workspace.Camera or nil
	end
end

function FirstPersonRig:destroy()
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
end

return FirstPersonRig
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000023"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Hud</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	Hud.luau
	Минималистичный HUD в духе Таркова: точка/крестик, патроны, слоты,
	полоска перезарядки, подсказки. Всё строится кодом — ассеты не нужны.

	Крестик динамический: расходится от движения, сходится в прицел.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HardOut"):WaitForChild("Config"))

local Hud = {}
Hud.__index = Hud

local COLOR_TEXT = Color3.fromRGB(228, 226, 216)
local COLOR_DIM = Color3.fromRGB(140, 138, 128)
local COLOR_ACCENT = Color3.fromRGB(198, 160, 94)
local COLOR_DANGER = Color3.fromRGB(206, 96, 74)

local SLOT_COUNT = Config.Inventory.Slots
local SLOT_SIZE = 42

local function label(parent, name, size, position, textSize, anchor)
	local instance = Instance.new("TextLabel")
	instance.Name = name
	instance.BackgroundTransparency = 1
	instance.Size = size
	instance.Position = position
	instance.AnchorPoint = anchor or Vector2.new(0, 0)
	instance.Font = Enum.Font.Code
	instance.TextSize = textSize
	instance.TextColor3 = COLOR_TEXT
	instance.TextXAlignment = Enum.TextXAlignment.Left
	instance.TextYAlignment = Enum.TextYAlignment.Center
	instance.Text = ""
	instance.Parent = parent
	return instance
end

function Hud.new()
	local self = setmetatable({}, Hud)

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "HardOutHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	self.gui = gui

	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = gui
	self.root = root

	self:buildCrosshair()
	self:buildAmmo()
	self:buildHotbar()
	self:buildReloadBar()
	self:buildHints()

	self.aimFactor = 0
	self.spreadVisual = 0
	self.slots = {}
	return self
end

function Hud:buildCrosshair()
	local container = Instance.new("Frame")
	container.Name = "Crosshair"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.fromOffset(120, 120)
	container.BackgroundTransparency = 1
	container.Parent = self.root
	self.crossContainer = container

	local function bar(name, size)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.BackgroundColor3 = COLOR_TEXT
		frame.BackgroundTransparency = 0.15
		frame.BorderSizePixel = 0
		frame.Size = size
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Parent = container
		return frame
	end

	self.bars = {
		top = bar("Top", UDim2.fromOffset(1, 7)),
		bottom = bar("Bottom", UDim2.fromOffset(1, 7)),
		left = bar("Left", UDim2.fromOffset(7, 1)),
		right = bar("Right", UDim2.fromOffset(7, 1)),
	}

	self.dot = bar("Dot", UDim2.fromOffset(2, 2))
	self.dot.BackgroundTransparency = 0.35
end

function Hud:buildAmmo()
	local holder = Instance.new("Frame")
	holder.Name = "Ammo"
	holder.AnchorPoint = Vector2.new(1, 1)
	holder.Position = UDim2.new(1, -26, 1, -26)
	holder.Size = UDim2.fromOffset(240, 76)
	holder.BackgroundTransparency = 1
	holder.Parent = self.root

	self.weaponLabel =
		label(holder, "WeaponName", UDim2.new(1, 0, 0, 18), UDim2.fromOffset(0, 0), 14, Vector2.new(1, 0))
	self.weaponLabel.TextXAlignment = Enum.TextXAlignment.Right
	self.weaponLabel.TextColor3 = COLOR_DIM

	self.ammoLabel = label(holder, "AmmoCount", UDim2.new(1, 0, 0, 48), UDim2.fromOffset(0, 20), 42, Vector2.new(1, 0))
	self.ammoLabel.TextXAlignment = Enum.TextXAlignment.Right
	self.ammoLabel.Text = "—"

	self.ammoTypeLabel =
		label(holder, "AmmoType", UDim2.new(1, 0, 0, 14), UDim2.fromOffset(0, 66), 12, Vector2.new(1, 0))
	self.ammoTypeLabel.TextXAlignment = Enum.TextXAlignment.Right
	self.ammoTypeLabel.TextColor3 = COLOR_DIM
end

function Hud:buildHotbar()
	local holder = Instance.new("Frame")
	holder.Name = "Hotbar"
	holder.AnchorPoint = Vector2.new(0.5, 1)
	holder.Position = UDim2.new(0.5, 0, 1, -20)
	holder.Size = UDim2.fromOffset(SLOT_COUNT * (SLOT_SIZE + 4), SLOT_SIZE)
	holder.BackgroundTransparency = 1
	holder.Parent = self.root

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = holder

	self.slotFrames = {}
	for index = 1, SLOT_COUNT do
		local slot = Instance.new("Frame")
		slot.Name = "Slot" .. index
		slot.Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE)
		slot.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
		slot.BackgroundTransparency = 0.45
		slot.BorderSizePixel = 0
		slot.Parent = holder

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(66, 64, 58)
		stroke.Thickness = 1
		stroke.Transparency = 0.5
		stroke.Parent = slot

		local number = label(slot, "Number", UDim2.fromOffset(16, 14), UDim2.fromOffset(3, 1), 11)
		number.Text = tostring(index)
		number.TextColor3 = COLOR_DIM

		local name = label(slot, "Name", UDim2.new(1, -6, 1, -18), UDim2.fromOffset(3, 16), 10)
		name.TextXAlignment = Enum.TextXAlignment.Center
		name.TextTruncate = Enum.TextTruncate.AtEnd
		name.TextYAlignment = Enum.TextYAlignment.Bottom

		self.slotFrames[index] = { frame = slot, stroke = stroke, name = name }
	end
end

function Hud:buildReloadBar()
	local holder = Instance.new("Frame")
	holder.Name = "ReloadBar"
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.new(0.5, 0, 0.5, 52)
	holder.Size = UDim2.fromOffset(150, 2)
	holder.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	holder.BackgroundTransparency = 0.35
	holder.BorderSizePixel = 0
	holder.Visible = false
	holder.Parent = self.root

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = COLOR_ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = holder

	self.reloadBar = holder
	self.reloadFill = fill
end

function Hud:buildHints()
	local hint = label(self.root, "Hints", UDim2.fromOffset(560, 70), UDim2.new(0, 20, 1, -104), 12)
	hint.TextColor3 = COLOR_DIM
	hint.TextYAlignment = Enum.TextYAlignment.Top
	hint.TextWrapped = true
	hint.Text = "WASD — движение   SHIFT — бег   C — присед   ПРОБЕЛ — прыжок\n"
		.. "ЛКМ — огонь   ПКМ — прицел   R — перезарядка   1–9 — слоты   X — убрать оружие\n"
		.. "Своё оружие: ReplicatedStorage.WeaponModels (см. docs/HANDS_AND_GUN.md)"
	self.hint = hint
end

--[[ Список слотов (модели оружия). ]]
function Hud:setSlots(slots)
	self.slots = slots or {}
	for index, entry in self.slotFrames do
		local weapon = self.slots[index]
		entry.name.Text = weapon and weapon.Name or ""
		entry.name.TextColor3 = weapon and COLOR_TEXT or COLOR_DIM
	end
end

function Hud:setWeapon(holder, slot)
	self.weaponLabel.Text = holder and string.upper(holder.sourceName) or ""
	self.ammoTypeLabel.Text = holder and holder.stats.AmmoType or ""

	self.activeSlot = slot
	for index, entry in self.slotFrames do
		local isActive = index == slot
		entry.stroke.Color = isActive and COLOR_ACCENT or Color3.fromRGB(66, 64, 58)
		entry.stroke.Transparency = isActive and 0.05 or 0.5
		entry.frame.BackgroundTransparency = isActive and 0.25 or 0.45
	end

	if holder then
		self:setAmmo(holder.stats.MagazineSize, holder.stats.MagazineSize)
	else
		self.ammoLabel.Text = "—"
		self:setReload(false, 1)
	end
end

function Hud:setAmmo(current, maximum)
	self.ammoLabel.Text = string.format("%d / %d", current, maximum)
	local low = current <= math.max(1, math.floor(maximum * 0.25))
	self.ammoLabel.TextColor3 = low and COLOR_DANGER or COLOR_TEXT
end

function Hud:setReload(reloading, progress)
	self.reloadBar.Visible = reloading == true and progress < 1
	self.reloadFill.Size = UDim2.fromScale(math.clamp(progress or 0, 0, 1), 1)
end

--[[ Показать/скрыть свой прицел целиком. ]]
function Hud:setCrosshairVisible(isVisible)
	if self.crossContainer then
		self.crossContainer.Visible = isVisible
	end
	if self.dot then
		self.dot.Visible = isVisible
	end
end

--[[ Прицел: в ADS крестик сходится и гаснет, остаётся точка. ]]
function Hud:setAim(aimFactor)
	self.aimFactor = aimFactor or 0
	local alpha = 1 - math.clamp(self.aimFactor, 0, 1)
	local gap = 4 + 10 * (1 - alpha)

	self.bars.top.Position = UDim2.new(0.5, 0, 0.5, -gap)
	self.bars.bottom.Position = UDim2.new(0.5, 0, 0.5, gap)
	self.bars.left.Position = UDim2.new(0.5, -gap, 0.5, 0)
	self.bars.right.Position = UDim2.new(0.5, gap, 0.5, 0)

	for _, bar in self.bars do
		bar.BackgroundTransparency = 1 - alpha * 0.85
	end
	self.dot.BackgroundTransparency = 0.35 + 0.55 * (1 - alpha)
end

return Hud
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000024"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Input</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	Input.luau
	Единая точка ввода. Держит состояние кнопок и раздаёт события
	подписчикам (PlayerController/WeaponController).

	Мышь 1 = огонь, мышь 2 = прицел, Shift = бег, C = присед,
	R = перезарядка, 1..9 = слоты, X = убрать оружие.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HardOut"):WaitForChild("Config"))

local Input = {}

Input.State = {
	Fire = false,
	Aim = false,
	Sprint = false,
	Crouch = false,
}

Input._handlers = {}

--[[ Подписка на действие. Возвращает объект с Disconnect. ]]
function Input.on(action, callback, phase)
	local handlers = Input._handlers[action]
	if not handlers then
		handlers = {}
		Input._handlers[action] = handlers
	end
	if not handlers[phase] then
		handlers[phase] = {}
	end
	local list = handlers[phase]
	table.insert(list, callback)
	return {
		Disconnect = function()
			local index = table.find(list, callback)
			if index then
				table.remove(list, index)
			end
		end,
	}
end

local function emit(action, phase, ...)
	Input.State[action] = (phase == "Began")
	local handlers = Input._handlers[action]
	if not handlers then
		return
	end
	local list = handlers[phase]
	if not list then
		return
	end
	for _, callback in ipairs(list) do
		task.spawn(callback, ...)
	end
end

local ACTION_BY_KEY = {
	[Config.Keys.Sprint] = "Sprint",
	[Config.Keys.Crouch] = "Crouch",
	[Config.Keys.Reload] = "Reload",
	[Config.Keys.Unequip] = "Unequip",
}

function Input.start()
	UserInputService.InputBegan:Connect(function(input, processed)
		-- Пробел ловим всегда: прыжком управляем мы, дефолтный ControlModule отключён.
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Space then
			emit("Jump", "Began")
			return
		end
		if processed then
			return
		end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 then
			emit("Fire", "Began")
		elseif kind == Enum.UserInputType.MouseButton2 then
			emit("Aim", "Began")
			Input.State.Aim = true
		elseif kind == Enum.UserInputType.Keyboard then
			local slot = tostring(input.KeyCode):match("^Enum%.KeyCode%.(%d)$")
			if slot then
				emit("Slot", "Began", tonumber(slot))
				return
			end
			local action = ACTION_BY_KEY[input.KeyCode]
			if action then
				emit(action, "Began")
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		-- Если игра потеряла фокус и вернула его — снова запираем мышь в центре.
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 then
			emit("Fire", "Ended")
		elseif kind == Enum.UserInputType.MouseButton2 then
			emit("Aim", "Ended")
		elseif kind == Enum.UserInputType.Keyboard then
			local action = ACTION_BY_KEY[input.KeyCode]
			if action then
				emit(action, "Ended")
			end
		end
	end)

	-- Минимум магии от Roblox: отключаем стандартный зум и смену камеры.
	UserInputService.WindowFocused:Connect(function()
		Input.State.Fire = false
		Input.State.Aim = false
	end)
end

return Input
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000025"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">PlayerController</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	PlayerController.luau
	Связывает всё воедино: камера, ViewModel, ввод, движение, обновления по кадрам.

	Порядок кадра:
	  1. RenderStepped: чтение мыши + движение персонажа + поза рук.
	  2. После этого камера уже стоит там, куда смотрит игрок.

	Движение своё (не Humanoid:MoveTo), потому что камера тоже своя:
	персонаж поворачивается строго по камере, без "петли" между ними.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))

local CameraModule = require(script.Parent.Camera)
local CharacterRig = require(script.Parent.CharacterRig)
local FirstPersonRig = require(script.Parent.FirstPersonRig)
local Input = require(script.Parent.Input)

local PlayerController = {}
PlayerController.__index = PlayerController

local player = Players.LocalPlayer

function PlayerController.new()
	local self = setmetatable({}, PlayerController)
	self.player = player
	self.camera = CameraModule.new(player)

	self.speed = 0
	self.isAiming = false
	self.isCrouching = false
	self.isSprinting = false
	self.walkSpeed = Config.Movement.WalkSpeed
	self.lean = 0
	self.rig = nil
	self.humanoid = nil
	self.character = nil
	self.adsFov = Config.Camera.BaseFov
	self.hud = nil
end

function PlayerController:start()
	Input.start()

	-- Камера и курсор.
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	Input.on("Aim", function()
		self.isAiming = true
		self.camera:setAiming(true, self.adsFov)
	end, "Began")
	Input.on("Aim", function()
		self.isAiming = false
		self.camera:setAiming(false, self.adsFov)
	end, "Ended")

	Input.on("Sprint", function()
		self.isSprinting = true
	end, "Began")
	Input.on("Sprint", function()
		self.isSprinting = false
	end, "Ended")

	Input.on("Crouch", function()
		self.isCrouching = not self.isCrouching
	end, "Began")

	Input.on("Jump", function()
		self.jumpRequested = true
		self:tryJump()
	end, "Began")
	Input.on("Jump", function()
		self.jumpRequested = false
	end, "Ended")

	self:bindCharacter()
	player.CharacterAdded:Connect(function(character)
		self:bindCharacter(character)
	end)

	-- Поза рук/ног — раз в кадр, прямо перед рендером.
	RunService.RenderStepped:Connect(function(dt)
		self:readInput()
		self:updateMovement(dt)
		self:updateCamera(dt)
		self:updateRig(dt)
	end)

	RunService.PostSimulation:Connect(function(dt)
		self:updateCharacterRotation(dt)
	end)
end

--[[ Прыжок свой: у дефолтного ControlModule он отключён вместе с модулем. ]]
function PlayerController:tryJump()
	local humanoid = self.humanoid
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - (self.lastJumpAt or 0) < 0.35 then
		return
	end
	local state = humanoid:GetState()
	if
		state == Enum.HumanoidStateType.Landed
		or state == Enum.HumanoidStateType.Running
		or state == Enum.HumanoidStateType.RunningNoPhysics
	then
		self.lastJumpAt = now
		humanoid.Jump = true
	else
		-- Запомнили намерение: прыгнем, как только приземлимся.
		self.jumpQueuedUntil = now + 0.25
	end
end

function PlayerController:bindCharacter(character)
	local current = character or player.Character
	if not current then
		return
	end
	self.character = current
	self.humanoid = current:WaitForChild("Humanoid")
	self.speed = 0

	-- Пересоздаём риг под нового персонажа.
	if self.rig then
		self.rig:destroy()
	end
	if Config.ViewModel.Mode == "Character" then
		-- Настоящий персонаж: его руки, ноги и штатные анимации.
		self.rig = CharacterRig.new(current)
	else
		-- Процедурные руки/ноги из кода.
		self.rig = FirstPersonRig.new(self.camera)
	end
	if self.onRigReady then
		self.onRigReady(self.rig)
	end
end

--[[ Читаем мышь (камера) и запоминаем инерцию для рук. ]]
function PlayerController:readInput()
	self.camera:readMouse()
end

--[[ Поворот персонажа строго по камере (иначе руки/коллизии разъедутся). ]]
function PlayerController:updateCharacterRotation(dt)
	local character = self.character
	local humanoid = self.humanoid
	if not (character and humanoid and humanoid.RootPart) then
		return
	end
	local flatLook = workspace.CurrentCamera.CFrame.LookVector * Vector3.new(1, 0, 1)
	if flatLook.Magnitude < 0.01 then
		return
	end
	local targetCFrame = CFrame.lookAt(humanoid.RootPart.Position, humanoid.RootPart.Position + flatLook.Unit)
	-- Человекообразные поворачиваются мгновенно, как в шутерах от первого лица.
	humanoid.RootPart.CFrame = humanoid.RootPart.CFrame:Lerp(targetCFrame, math.clamp(dt * 25, 0, 1))
end

function PlayerController:updateMovement(dt)
	local humanoid = self.humanoid
	if not humanoid or humanoid.Health <= 0 then
		self.speed = 0
		return
	end

	local moveX, moveZ = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		moveZ -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		moveZ += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		moveX -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		moveX += 1
	end

	local camera = workspace.CurrentCamera
	local flatLook = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end
	local flatRight = flatLook:Cross(Vector3.new(0, 1, 0))

	local worldMove = flatLook * -moveZ + flatRight * moveX
	if worldMove.Magnitude > 0 then
		worldMove = worldMove.Unit
	end

	-- Тарковские скорости: медленно, весомо.
	local targetSpeed = Config.Movement.WalkSpeed
	if self.isCrouching then
		targetSpeed = Config.Movement.CrouchSpeed
	elseif self.isAiming then
		targetSpeed = Config.Movement.AimWalkSpeed
	elseif self.isSprinting and moveZ < 0 then
		targetSpeed = Config.Movement.SprintSpeed
	end

	-- Вес снаряжения и состояния (RaidSandbox на сервере) режут скорость.
	targetSpeed *= player:GetAttribute("HardOutSpeedMult") or 1

	-- Разгон/торможение, чтобы не было "роблоксовой" липкости.
	local rate = 1 / math.max(Config.Movement.AccelerationTime or 0.16, 0.01)
	self.walkSpeed += (targetSpeed - self.walkSpeed) * math.clamp(dt * rate, 0, 1)

	humanoid.WalkSpeed = self.walkSpeed
	humanoid:Move(worldMove * (worldMove.Magnitude > 0 and 1 or 0), false)

	-- Зажатый пробел / прыжок в воздухе: дожимаем, когда коснёмся земли.
	if self.jumpRequested or (self.jumpQueuedUntil and os.clock() < self.jumpQueuedUntil) then
		self:tryJump()
	end

	-- Присед: уменьшаем HipHeight, чтобы модель реально опускалась.
	local targetHip = self.isCrouching and 1.2 or 2
	humanoid.HipHeight += (targetHip - humanoid.HipHeight) * math.clamp(dt * 10, 0, 1)

	local velocity = humanoid.RootPart and humanoid.RootPart.AssemblyLinearVelocity or Vector3.zero
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	self.speed = horizontal
	self.camera:setMovement(horizontal, self.isCrouching)
	self.camera:setLean(moveX)
	self.lean = moveX
end

function PlayerController:updateCamera(dt)
	self.camera:update(dt)
end

function PlayerController:updateRig(dt)
	if not self.rig then
		return
	end
	self.rig:addLook(self.camera.lastDelta.X, self.camera.lastDelta.Y)
	self.rig:setState({
		speed = self.speed,
		isAiming = self.isAiming,
		isSprinting = self.isSprinting,
		isCrouching = self.isCrouching,
		lean = self.lean,
	})
	self.rig:update(dt)
end

function PlayerController:setAdsFov(fov)
	self.adsFov = fov
	self.camera:setAiming(self.isAiming, fov)
end

return PlayerController
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000026"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">Tracers</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	Tracers.luau
	Визуал выстрелов: трассер (линия от ствола до попадания), вспышка в точке удара.
	Слушает ShotResult с сервера, поэтому видно ВСЕ выстрелы, включая чужие.

	Ассеты не используются: трассер — тонкая Part с Neon, искры — ParticleEmitter.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Net = require(HardOut:WaitForChild("Net"):WaitForChild("Remotes"))
local Config = require(HardOut:WaitForChild("Config"))

local Tracers = {}

local tracerFolder

local function getFolder()
	if not tracerFolder or not tracerFolder.Parent then
		tracerFolder = Instance.new("Folder")
		tracerFolder.Name = "HardOutTracers"
		tracerFolder.Parent = workspace
	end
	return tracerFolder
end

local function spawnTracer(from, to)
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.5 then
		return
	end

	local tracer = Instance.new("Part")
	tracer.Name = "Tracer"
	tracer.Size = Vector3.new(0.06, 0.06, length)
	tracer.CFrame = CFrame.lookAt(from + delta * 0.5, to)
	tracer.Anchored = true
	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.CanTouch = false
	tracer.CastShadow = false
	tracer.Material = Enum.Material.Neon
	tracer.Color = Color3.fromRGB(255, 214, 150)
	tracer.Transparency = 0.25
	tracer.Parent = getFolder()
	Debris:AddItem(tracer, Config.Debug.TraceLifetime)
end

local function spawnImpact(position, normal)
	local impact = Instance.new("Part")
	impact.Name = "Impact"
	impact.Size = Vector3.new(0.1, 0.1, 0.1)
	impact.CFrame = CFrame.new(position)
	impact.Anchored = true
	impact.CanCollide = false
	impact.CanQuery = false
	impact.CanTouch = false
	impact.CastShadow = false
	impact.Transparency = 1
	impact.Parent = getFolder()

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparks"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 220, 160), Color3.fromRGB(120, 110, 100))
	emitter.Lifetime = NumberRange.new(0.12, 0.3)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.18),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Enabled = true
	emitter.Parent = impact
	emitter:Emit(8)
	Debris:AddItem(impact, 0.6)

	local decal = Instance.new("Part")
	decal.Name = "BulletHole"
	decal.Size = Vector3.new(0.22, 0.22, 0.02)
	decal.CFrame = CFrame.lookAt(position + normal * 0.01, position + normal)
	decal.Anchored = true
	decal.CanCollide = false
	decal.CanQuery = false
	decal.CanTouch = false
	decal.CastShadow = false
	decal.Color = Color3.fromRGB(16, 16, 16)
	decal.Material = Enum.Material.SmoothPlastic
	decal.Parent = getFolder()
	Debris:AddItem(decal, 12)
end

function Tracers.initialize()
	local remote = Net.waitFor(Net.Names.ShotResult)
	remote.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" then
			return
		end
		local origin = payload.origin
		local position = payload.position
		if typeof(origin) ~= "Vector3" or typeof(position) ~= "Vector3" then
			return
		end
		spawnTracer(origin, position)
		if payload.hit then
			local normal = typeof(payload.normal) == "Vector3" and payload.normal or Vector3.new(0, 1, 0)
			spawnImpact(position, normal)
		end
	end)
end

return Tracers
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000027"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">WeaponController</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	WeaponController.luau
	Оружие в руках на клиенте: слоты, экипировка, стрельба, перезарядка, эффекты.

	Роли:
	  * WeaponState  — чистая логика патронов/темпа (та же, что на сервере);
	  * WeaponHolder — визуал и сокеты модели оружия;
	  * сервер       — единственный, кто наносит урон.

	Стенд: оружие берётся из ReplicatedStorage.WeaponModels. Положил модель —
	она автоматически попадает в слот 1 (и далее по алфавиту).
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local Config = require(HardOut:WaitForChild("Config"))
local Net = require(HardOut:WaitForChild("Net"):WaitForChild("Remotes"))
local WeaponFolder = HardOut:WaitForChild("Weapon")
local Ballistics = require(WeaponFolder:WaitForChild("Ballistics"))
local WeaponState = require(WeaponFolder:WaitForChild("WeaponState"))

local WeaponHolder = require(script.Parent.WeaponHolder)
local Input = require(script.Parent.Input)

local rng = Random.new()

local WeaponController = {}
WeaponController.__index = WeaponController

--[[ controller — PlayerController (камера, риг, HUD). ]]
function WeaponController.new(controller)
	local self = setmetatable({}, WeaponController)
	self.controller = controller
	self.rig = controller.rig

	self.slots = {}
	self.activeSlot = nil
	self.holder = nil
	self.state = nil
	self.triggerHeld = false
	self.shotIndex = 0

	self.fireRemote = Net.waitFor(Net.Names.Fire)
	self.reloadRemote = Net.waitFor(Net.Names.Reload)

	self:bindInput()
	self:refreshInventory()

	-- Персонаж мог появиться ДО создания контроллера оружия: надеваем сразу.
	if controller.rig and self.slots[Config.Inventory.FirstSlot] then
		self:equip(Config.Inventory.FirstSlot)
	end

	-- Если риг пересоздали (респавн) — перевешиваем оружие.
	controller.onRigReady = function(rig)
		self.rig = rig
		local slot = self.activeSlot
		self:unequip()
		if slot and self.slots[slot] then
			self:equip(slot)
		elseif self.slots[1] then
			self:equip(Config.Inventory.FirstSlot)
		end
	end

	-- Подхватываем модели, добавленные позже (удобно при разработке).
	task.spawn(function()
		local folder = WeaponHolder.resolveWeaponFolder()
		if folder then
			folder.ChildAdded:Connect(function()
				task.wait(0.2)
				self:refreshInventory()
			end)
			folder.ChildRemoved:Connect(function()
				self:refreshInventory()
			end)
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)
	return self
end

function WeaponController:bindInput()
	Input.on("Fire", function()
		self.triggerHeld = true
		self:tryFire()
	end, "Began")

	Input.on("Fire", function()
		self.triggerHeld = false
		if self.state then
			self.state:releaseTrigger()
		end
		self.shotIndex = 0
	end, "Ended")

	Input.on("Reload", function()
		self:reload()
	end, "Began")

	Input.on("Unequip", function()
		if self.activeSlot then
			self:unequip()
		elseif self.slots[1] then
			self:equip(1)
		end
	end, "Began")

	Input.on("Slot", function(slot)
		self:equip(slot)
	end, "Began")
end

--[[ Перечитывает папку оружия. ]]
function WeaponController:refreshInventory()
	local weapons = WeaponHolder.listWeapons()
	self.slots = {}
	for index, weapon in weapons do
		self.slots[index] = weapon
	end

	if Config.Debug.Verbose then
		if #weapons == 0 then
			warn(
				"[HardOut] ReplicatedStorage.WeaponModels пуста. "
					.. "Положи туда модель оружия (Model) — стенд подхватит её сам."
			)
		else
			for _, weapon in weapons do
				WeaponHolder.report(weapon)
			end
		end
	end

	if self.controller.hud then
		self.controller.hud:setSlots(self.slots)
	end

	if not self.activeSlot and self.slots[Config.Inventory.FirstSlot] then
		self:equip(Config.Inventory.FirstSlot)
	end
end

function WeaponController:equip(slot)
	local weapon = self.slots[slot]
	if not weapon or self.activeSlot == slot then
		return
	end

	self:unequip()
	self.activeSlot = slot
	self.rig = self.controller.rig
	if not self.rig then
		warn(
			"[HardOut] Нет ViewModel (персонаж ещё не появился) — оружие не надеть."
		)
		self.activeSlot = nil
		return
	end

	self.holder = WeaponHolder.new(self.rig, weapon)
	self.state = WeaponState.new(self.holder.stats)
	self.shotIndex = 0

	self.controller:setAdsFov(self.holder.stats.AdsFov)
	if self.controller.hud then
		self.controller.hud:setSlots(self.slots)
		self.controller.hud:setWeapon(self.holder, slot)
		self:pushState()
	end
end

function WeaponController:unequip()
	if self.holder then
		self.holder:destroy()
		self.holder = nil
	end
	self.state = nil
	self.activeSlot = nil
	if self.controller.hud then
		self.controller.hud:setWeapon(nil)
	end
end

function WeaponController:reload()
	if not self.state then
		return
	end
	if self.state:startReload(os.clock()) then
		self.shotIndex = 0
		self.reloadRemote:FireServer()
	end
end

function WeaponController:tryFire()
	if not (self.state and self.holder) then
		return
	end
	local now = os.clock()
	local canFire = self.state:canFire(now)
	if not canFire then
		if self.state.magazine <= 0 and not self.state.reloading then
			self:reload()
		end
		return
	end

	local stats = self.state.stats
	self.state:fire(now)
	self.shotIndex = math.min(self.shotIndex + 1, 40)

	-- Отдача: паттерн + визуальный импульс камеры.
	local yaw, pitch = Ballistics.recoilOffset(stats, self.shotIndex - 1, function()
		return rng:NextNumber()
	end)
	self.controller.camera:addRecoil(yaw, pitch, stats.RecoilVisual)

	self:spawnMuzzleFlash()
	self:playShotSound()

	local origin, direction = self.controller.camera:getLookRay()
	self.fireRemote:FireServer({
		weaponName = self.holder.sourceName,
		origin = origin,
		direction = direction,
		shotIndex = self.shotIndex,
		aiming = self.controller.isAiming,
		speed = self.controller.speed,
	})

	self:pushState()
end

function WeaponController:spawnMuzzleFlash()
	local muzzle = self.holder:getMuzzleCFrame()

	local flash = Instance.new("Part")
	flash.Name = "MuzzleFlash"
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(0.3, 0.3, 0.3)
	flash.Color = Color3.fromRGB(255, 205, 130)
	flash.Material = Enum.Material.Neon
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.CFrame = muzzle
	flash.Parent = workspace
	Debris:AddItem(flash, 0.04)

	local light = Instance.new("PointLight")
	light.Brightness = 5
	light.Range = 14
	light.Color = Color3.fromRGB(255, 190, 110)
	light.Parent = flash
end

function WeaponController:playShotSound()
	-- Ассетов нет специально: подставь свой rbxassetid в Config.Weapons.ShotSoundId.
	local soundId = Config.Weapons.ShotSoundId
	if not soundId or soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 0.6
	sound.RollOffMaxDistance = 250
	sound.Parent = self.holder.root
	sound:Play()
	Debris:AddItem(sound, 3)
end

function WeaponController:pushState()
	if not self.state or not self.controller.hud then
		return
	end
	self.controller.hud:setAmmo(self.state.magazine, self.state.stats.MagazineSize)
	self.controller.hud:setReload(self.state.reloading, self.state:reloadProgress(os.clock()))
end

function WeaponController:update(dt)
	if not self.state then
		return
	end

	-- Оружие плавно подъезжает к центру в прицеле.
	if self.holder and self.holder.setAim then
		self.holder:setAim(self.controller.camera:getAimFactor(), dt)
	end

	if self.triggerHeld then
		self:tryFire()
	end

	if self.state:update(os.clock()) then
		self:pushState()
	end

	if self.controller.hud then
		self.controller.hud:setAim(self.controller.camera:getAimFactor())
		self.controller.hud:setReload(self.state.reloading, self.state:reloadProgress(os.clock()))
	end
end

return WeaponController
]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000028"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="Disabled">false</bool><string name="Name">WeaponHolder</string><int64 name="SourceAssetId">-1</int64><string name="Source"><![CDATA[--!nonstrict
--[[
	WeaponHolder.luau
	ЗАГОТОВКА ПОД ОРУЖИЕ — здесь модель пушки превращается в "оружие в руках".

	Что делает по шагам:
	  1. Клонирует модель из ReplicatedStorage.WeaponModels.
	  2. Ищет сокеты Grip / Support / Muzzle / Sight (см. docs/HANDS_AND_GUN.md).
	  3. Мягко чинит проблемы: нет Grip -> цепляем по центру + warn.
	  4. Опционально масштабирует под эталон (Config.Weapons.AutoScale).
	  5. Жёстко привязывает модель к правой кисти через Weld
	     (обе части неанкоренные, поэтому оружие честно едет за рукой).
	  6. Отдаёт наружу статы и сокеты: Muzzle для вспышки/трассера, Sight для ADS.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HardOut = ReplicatedStorage:WaitForChild("HardOut")
local WeaponFolder = HardOut:WaitForChild("Weapon")

local Config = require(HardOut:WaitForChild("Config"))
local GunPreset = require(WeaponFolder:WaitForChild("GunPreset"))
local WeaponConfig = require(WeaponFolder:WaitForChild("WeaponConfig"))

local WeaponHolder = {}
WeaponHolder.__index = WeaponHolder

--[[ Путь "ReplicatedStorage.WeaponModels" -> Instance. ]]
function WeaponHolder.resolveWeaponFolder()
	local current = game :: any
	for segment in string.gmatch(Config.Weapons.FolderPath, "[^%.]+") do
		local nextInstance = current:FindFirstChild(segment)
		if not nextInstance then
			return nil
		end
		current = nextInstance
	end
	return current
end

--[[ Модели оружия из папки, отсортированные по имени. ]]
function WeaponHolder.listWeapons()
	local folder = WeaponHolder.resolveWeaponFolder()
	if not folder then
		return {}
	end
	local weapons = {}
	for _, child in folder:GetChildren() do
		if child:IsA("Model") then
			table.insert(weapons, child)
		end
	end
	table.sort(weapons, function(a, b)
		return a.Name < b.Name
	end)
	return weapons
end

--[[ Печатает в консоль результат проверки модели. ]]
function WeaponHolder.report(weapon)
	local issue, sockets = GunPreset.diagnose(weapon)
	local names = {}
	for key in sockets do
		table.insert(names, key)
	end
	table.sort(names)

	if issue then
		warn(string.format("[HardOut] Модель '%s': %s", weapon.Name, issue))
	else
		print(
			string.format(
				"[HardOut] Модель '%s' OK. Сокеты: %s",
				weapon.Name,
				#names > 0 and table.concat(names, ", ") or "нет"
			)
		)
	end
	return issue, sockets
end

function WeaponHolder.new(rig, weapon)
	local self = setmetatable({}, WeaponHolder)
	self.rig = rig
	self.sourceName = weapon.Name
	self.stats = WeaponConfig.fromModel(weapon)

	self.cloned = weapon:Clone()

	if Config.Weapons.AutoScale then
		GunPreset.applyScale(self.cloned, GunPreset.computeScale(self.cloned))
	end

	self.cloned.Name = "HardOutWeapon_" .. weapon.Name
	self:prepareParts()
	self.cloned.Parent = workspace.Camera

	self.sockets = {}
	self:resolveSockets()
	self:attach()
	return self
end

--[[ Части: без коллизий/рейкастов и неанкоренные (иначе Weld не потащит). ]]
function WeaponHolder:prepareParts()
	local primary = self.cloned.PrimaryPart
	if not primary then
		primary = self.cloned:FindFirstChildWhichIsA("BasePart", true)
		self.cloned.PrimaryPart = primary
	end

	for _, descendant in self.cloned:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
		elseif descendant:IsA("ParticleEmitter") or descendant:IsA("Light") then
			-- Свет/эффекты из исходной модели могут мигать — гасим, стенд добавит свои.
			descendant.Enabled = false
		end
	end
	self.root = primary
end

function WeaponHolder:resolveSockets()
	for key, name in GunPreset.AttachmentNames do
		local attachment = GunPreset.getAttachment(self.cloned, name)
		if attachment then
			self.sockets[key] = attachment
		end
	end
end

--[[ Привязка к правой кисти: Weld c C0 = кисть, C1 = точка Grip. ]]
function WeaponHolder:attach()
	local root = self.root
	if not root then
		warn(
			string.format(
				"[HardOut] В модели '%s' нет ни одной BasePart — держать нечего.",
				self.sourceName
			)
		)
		return
	end

	local grip = self.sockets.Grip
	if not grip then
		warn(
			string.format(
				"[HardOut] '%s': нет Attachment 'Grip'. Оружие встанет по центру модели; "
					.. "добавь Attachments.Grip, чтобы настроить хват (docs/HANDS_AND_GUN.md).",
				self.sourceName
			)
		)
		local fallback = Instance.new("Attachment")
		fallback.Name = "Grip"
		fallback.Parent = root
		grip = fallback
		self.sockets.Grip = fallback
	end

	-- C1 — CFrame.Grip в системе координат корневой части оружия.
	local gripWorld = (grip.Parent :: BasePart).CFrame * grip.CFrame
	local gripRelative = root.CFrame:ToObjectSpace(gripWorld)

	-- Кисть берём у рига: у настоящего персонажа это RightHand/Right Arm,
	-- у процедурного — конец правой руки. Так оружие работает в обоих режимах.
	local handPart = self.rig.handPart or (self.rig.handAnchor and self.rig.handAnchor.Parent)
	if not handPart or not handPart:IsA("BasePart") then
		warn("[HardOut] Не найдена кисть для крепления оружия.")
		return
	end
	self.handPart = handPart

	local gripCFrame = Config.Weapons.HandGripCFrame
	if self.rig.getGripCFrame then
		gripCFrame = self.rig:getGripCFrame()
	elseif self.rig.handAnchor then
		gripCFrame = self.rig.handAnchor.CFrame
	end

	local weld = Instance.new("Weld")
	weld.Name = "WeaponWeld"
	weld.Part0 = handPart
	weld.Part1 = root
	weld.C0 = gripCFrame
	weld.C1 = gripRelative
	weld.Parent = handPart
	self.weld = weld
	self.baseGrip = gripCFrame
	self.aimAlpha = 0
end

--[[
	Прицеливание (ADS) для настоящей руки: позу руки мы не трогаем (её ведёт
	аниматор персонажа), поэтому оружие само плавно подъезжает к центру кадра.
	Для процедурного рига рука и так поднимается — там сдвиг меньше.
]]
function WeaponHolder:setAim(alpha: number, dt: number)
	if not self.weld or not self.baseGrip then
		return
	end
	local target = math.clamp(alpha or 0, 0, 1)
	self.aimAlpha += (target - self.aimAlpha) * math.clamp(dt * 12, 0, 1)

	local offset = Config.Weapons.AimOffset or CFrame.new()
	self.weld.C0 = self.baseGrip * CFrame.new(offset.Position * self.aimAlpha)
end

function WeaponHolder:getMuzzleCFrame(): CFrame
	local muzzle = self.sockets.Muzzle
	if muzzle then
		return muzzle.WorldCFrame
	end
	if self.root then
		return self.root.CFrame * CFrame.new(0, 0, -self.root.Size.Z * 0.5)
	end
	return CFrame.new(0, 0, 0)
end

function WeaponHolder:getSightCFrame(): CFrame?
	local sight = self.sockets.Sight
	if sight then
		return sight.WorldCFrame
	end
	return nil
end

function WeaponHolder:destroy()
	if self.weld then
		self.weld:Destroy()
		self.weld = nil
	end
	if self.cloned then
		self.cloned:Destroy()
		self.cloned = nil
	end
end

return WeaponHolder
