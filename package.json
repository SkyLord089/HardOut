{
  "name": "hardout",
  "version": "0.1.0",
  "private": true,
  "description": "Тестовый стенд FPS-режима для Roblox (вид от первого лица, руки/ноги, заготовка под оружие)",
  "scripts": {
    "check": "node tools/luau-check.mjs",
    "test": "node tools/run-tests.mjs",
    "verify": "npm run check && npm test",
    "build": "rojo build default.project.json -o HardOut.rbxlx",
    "serve": "rojo serve",
    "build:place": "python3 tools/build_place.py",
    "verify:place": "python3 tools/verify_place.py HardOut.rbxlx",
    "verify:all": "npm run check && npm test && npm run build:place && npm run verify:place",
    "check:dom": "node tools/dom-check.js HardOut.rbxlx",
    "check:ctors": "node tools/constructor-check.mjs"
  },
  "devDependencies": {
    "@luau-rs/luau": "^0.739.0"
  }
}
